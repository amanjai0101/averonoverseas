# ── Canonical URL (no trailing slash) ─────────────────────────────────────
# Change to https://www.averonoverseas.com once the custom domain is live.
SITE_URL=https://averonoverseas.github.io

# ── Base path ──────────────────────────────────────────────────────────────
# '/averonoverseas' for GitHub Pages repo; '/' for custom domain root.
BASE_PATH=/averonoverseas

# ── Indexing control ───────────────────────────────────────────────────────
# Set to "true" ONLY after www.averonoverseas.com is verified in Search Console.
# "false" = noindex on every page + robots.txt Disallow all.
PUBLIC_INDEXABLE=false

# ── Web3Forms (form submissions) ───────────────────────────────────────────
# Get your free access key at https://web3forms.com/
PUBLIC_WEB3FORMS_KEY=c4ae811b-c5ce-404b-901e-897b630e50d3

# ── GoatCounter (cookieless analytics) ────────────────────────────────────
# Your GoatCounter site code (the subdomain part of yourcode.goatcounter.com).
# Leave empty to disable analytics.
PUBLIC_GOATCOUNTER_CODE=averonoverseas
