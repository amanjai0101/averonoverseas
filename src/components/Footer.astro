---
import { getCategories, getSiteConfig } from '../data/index.ts';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
interface Props { lang?: string; }
const categories = await getCategories();
const cfg = await getSiteConfig();
const year = new Date().getFullYear();

const social = cfg.social ?? {};
const socialLinks = [
  { key: 'linkedin',  label: 'LinkedIn',  href: social.linkedin,  icon: `<svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>` },
  { key: 'x',         label: 'X (Twitter)',href: social.x,         icon: `<svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-4.714-6.231-5.401 6.231H2.744l7.733-8.835L2.25 2.25h6.963l4.261 5.634zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>` },
  { key: 'instagram', label: 'Instagram',  href: social.instagram, icon: `<svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/></svg>` },
  { key: 'facebook',  label: 'Facebook',   href: social.facebook,  icon: `<svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>` },
  // Email shown as a social link
  { key: 'email', label: 'Email', href: `mailto:${cfg.email}`, icon: `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="2" y="4" width="20" height="16" rx="2"/><polyline points="2,4 12,13 22,4"/></svg>` },
].filter(s => !!s.href);
---

<footer class="site-footer">
  <div class="wrap footer-grid">

    <!-- Col 1: Brand -->
    <div class="footer-brand">
      <a href={`${base}/`} class="footer-logo-link" aria-label="Averon Overseas — home">
        <img src={`${base}/images/averon-logo.webp`} alt="Averon Overseas" width="36" height="36" loading="lazy" />
        <span class="footer-wm">AVERON OVERSEAS</span>
      </a>
      <p class="footer-desc">{cfg.description}</p>
      <address class="footer-addr">
        {cfg.address.city}, {cfg.address.state} {cfg.address.postcode}, {cfg.address.country}
      </address>
      {cfg.iec && <p class="footer-reg">IEC: <span class="mono">{cfg.iec}</span></p>}
      {cfg.gstin && <p class="footer-reg">GSTIN: <span class="mono">{cfg.gstin}</span></p>}
      {cfg.established && <p class="footer-reg">Est. {cfg.established}</p>}
      <a href={`${base}/downloads/averon-overseas-product-catalogue-2026.pdf`} class="footer-cat-link" download>
        ↓ Download catalogue
      </a>
      <!-- Social icons -->
      {socialLinks.length > 0 && (
        <div class="footer-social" role="list" aria-label="Social media">
          {socialLinks.map(s => (
            <a
              href={s.href}
              class="social-icon"
              role="listitem"
              aria-label={s.label}
              target={s.key !== 'email' ? '_blank' : undefined}
              rel={s.key !== 'email' ? 'noopener noreferrer' : undefined}
              set:html={s.icon}
            />
          ))}
        </div>
      )}
    </div>

    <!-- Col 2: Products -->
    <nav aria-label="Product categories">
      <p class="footer-col-head">Products</p>
      <ul>
        {categories.filter(c => c.slug !== 'raw-materials').map(c => (
          <li><a href={`${base}/products/${c.slug}/`}>{c.name}</a></li>
        ))}
        <li><a href={`${base}/products/`}>All products →</a></li>
      </ul>
    </nav>

    <!-- Col 3: Company -->
    <nav aria-label="Company links">
      <p class="footer-col-head">Company</p>
      <ul>
        <li><a href={`${base}/about/`}>About</a></li>
        <li><a href={`${base}/raw-materials/`}>Raw Materials</a></li>
        <li><a href={`${base}/documents/`}>Documents</a></li>
        <li><a href={`${base}/contact/`}>Contact</a></li>
        <li><a href={`${base}/rfq/`}>Request a quote</a></li>
      </ul>
    </nav>

    <!-- Col 4: Contact -->
    <div class="footer-contact">
      <p class="footer-col-head">Contact</p>
      <ul>
        <li><a href={`mailto:${cfg.email}`}>{cfg.email}</a></li>
        {cfg.phones.map(p => <li><a href={`tel:${p.replace(/[^+\d]/g,'')}`}>{p}</a></li>)}
      </ul>
    </div>

  </div>

  <!-- Legal row -->
  <div class="footer-legal">
    <div class="wrap footer-legal-inner">
      <span>&copy; {year} Averon Overseas</span>
      <a href={`${base}/privacy/`}>Privacy Policy</a>
      <a href={`${base}/terms/`}>Terms of Use</a>
      <a href={`${base}/sitemap.xml`}>Sitemap</a>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--band); border-top: 1px solid var(--hair);
    padding-top: 56px; padding-bottom: env(safe-area-inset-bottom, 0px);
  }
  .footer-grid {
    display: grid; grid-template-columns: 2fr 1fr 1fr 1fr;
    gap: 40px; padding-bottom: 48px;
  }
  .footer-logo-link {
    display: inline-flex; align-items: center; gap: 10px;
    text-decoration: none; margin-bottom: 12px;
  }
  .footer-logo-link img { width: 36px; height: 36px; object-fit: contain; background: transparent; }
  .footer-logo-link:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }
  .footer-wm { font-family: var(--serif); font-size: 0.9375rem; color: var(--ink); letter-spacing: 0.06em; }
  .footer-desc { font-size: 0.875rem; color: var(--muted); line-height: 1.6; margin: 0 0 6px; max-width: 32ch; }
  address { font-style: normal; font-size: 0.875rem; color: var(--muted); margin-bottom: 6px; }
  .footer-reg { font-size: 0.8125rem; color: var(--muted); margin: 0 0 4px; }
  .footer-cat-link { font-size: 0.8125rem; font-weight: 600; color: var(--ink); text-decoration: none; display: block; margin-top: 8px; }
  .footer-cat-link:hover { text-decoration: underline; }

  /* Social icons */
  .footer-social { display: flex; gap: 12px; margin-top: 14px; flex-wrap: wrap; }
  .social-icon {
    display: flex; align-items: center; justify-content: center;
    width: 36px; height: 36px; color: var(--muted);
    border: 1px solid var(--hair); text-decoration: none;
    transition: color 0.12s, border-color 0.12s;
  }
  .social-icon:hover { color: var(--ink); border-color: var(--ink); }
  .social-icon:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }

  .footer-col-head { font-weight: 600; font-size: 0.8125rem; color: var(--ink); margin: 0 0 12px; }
  nav ul, .footer-contact ul { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 6px; }
  nav a, .footer-contact a {
    font-size: 0.875rem; color: var(--muted); text-decoration: none;
    padding: 2px 0; min-height: 28px; display: flex; align-items: center; transition: color 0.12s;
  }
  nav a:hover, .footer-contact a:hover { color: var(--ink); }
  nav a:focus-visible, .footer-contact a:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }

  .footer-legal { border-top: 1px solid var(--hair); padding: 16px 0; }
  .footer-legal-inner {
    display: flex; gap: 24px; align-items: center; flex-wrap: wrap;
    font-size: 0.8125rem; color: var(--muted);
  }
  .footer-legal-inner a { color: inherit; text-decoration: none; }
  .footer-legal-inner a:hover { text-decoration: underline; }

  @media (max-width: 860px) { .footer-grid { grid-template-columns: 1fr 1fr; } .footer-brand { grid-column: 1/-1; } }
  @media (max-width: 540px) { .footer-grid { grid-template-columns: 1fr; } }
</style>
