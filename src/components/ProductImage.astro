---
/**
 * ProductImage — renders a product image from /public/images/.
 * Falls back to a quiet neutral placeholder (no dashed outline, no badge text).
 */
import { existsSync } from 'fs';
import { join } from 'path';

interface Props {
  src: string;
  alt: string;
  width?: number;
  height?: number;
  aspectRatio?: string; // e.g. "4/3" or "1/1"
  loading?: 'lazy' | 'eager';
  class?: string;
}

const {
  src,
  alt,
  width = 800,
  height = 600,
  aspectRatio = '4/3',
  loading = 'lazy',
  class: extraClass = '',
} = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const diskPath = join(process.cwd(), 'public', 'images', src);
const fileExists = src && existsSync(diskPath);
const imgSrc = `${base}/images/${src}`;
---

{fileExists ? (
  <div class={`pi-frame ${extraClass}`} style={`aspect-ratio:${aspectRatio}`}>
    <img
      src={imgSrc}
      alt={alt}
      width={width}
      height={height}
      loading={loading}
      decoding="async"
      class="pi-img"
    />
  </div>
) : (
  <div
    class={`pi-frame pi-placeholder ${extraClass}`}
    role="img"
    aria-label={alt}
    style={`aspect-ratio:${aspectRatio}`}
  >
    <span class="pi-label">{alt}</span>
  </div>
)}

<style>
  .pi-frame {
    background: var(--band);
    display: flex; align-items: center; justify-content: center;
    overflow: hidden; width: 100%;
  }
  .pi-img {
    width: 100%; height: 100%;
    object-fit: contain;
    display: block;
  }
  .pi-placeholder {
    color: var(--muted);
    font-size: 0.875rem;
    font-family: var(--sans);
    text-align: center;
    padding: 16px;
  }
  .pi-label {
    display: block;
    max-width: 20ch;
    line-height: 1.4;
  }
</style>
