---
/**
 * ProductImage — renders a product image from /public/images/.
 * Falls back to a quiet neutral placeholder with no dashed outlines.
 * Always uses object-fit: contain on white background.
 */
import { existsSync } from 'fs';
import { join } from 'path';

interface Props {
  src: string;
  alt: string;
  aspectRatio?: string; // e.g. "4/3" or "1/1" or "3/2"
  loading?: 'lazy' | 'eager';
  class?: string;
  width?: number;
  height?: number;
}

const {
  src,
  alt,
  aspectRatio = '4/3',
  loading = 'lazy',
  class: extraClass = '',
  width = 800,
  height = 600,
} = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const fileExists = src
  ? existsSync(join(process.cwd(), 'public', 'images', src))
  : false;
const imgSrc = `${base}/images/${src}`;
---

{fileExists ? (
  <div class={`pi-frame ${extraClass}`} style={`aspect-ratio:${aspectRatio}`}>
    <img
      src={imgSrc}
      alt={alt}
      width={width}
      height={height}
      loading={loading}
      decoding="async"
      class="pi-img"
    />
  </div>
) : (
  <div
    class={`pi-frame pi-ph ${extraClass}`}
    role="img"
    aria-label={alt}
    style={`aspect-ratio:${aspectRatio}`}
  >
    <span class="pi-ph-label">{alt}</span>
  </div>
)}

<style>
  .pi-frame {
    background: var(--panel);
    display: flex; align-items: center; justify-content: center;
    overflow: hidden; width: 100%;
  }
  .pi-img {
    width: 100%; height: 100%;
    object-fit: contain; display: block;
  }
  .pi-ph {
    color: var(--muted); font-size: 0.8125rem;
    font-family: var(--sans); text-align: center; padding: 16px;
  }
  .pi-ph-label { display: block; max-width: 22ch; line-height: 1.4; }
</style>
