---
/**
 * ProductImage — renders a product image from /public/images/.
 * If the file is not present, renders a styled SVG placeholder frame
 * with the product name labelled, so broken <img> tags never appear.
 *
 * Props:
 *   src       - filename only, e.g. "closures-caps-crc-1.webp"
 *   alt       - descriptive alt text
 *   width     - intrinsic width  (default 800)
 *   height    - intrinsic height (default 600)
 *   class     - optional extra CSS classes
 *   loading   - "lazy" | "eager" (default "lazy")
 */
import { existsSync } from 'fs';
import { join } from 'path';

interface Props {
  src: string;
  alt: string;
  width?: number;
  height?: number;
  class?: string;
  loading?: 'lazy' | 'eager';
}

const {
  src,
  alt,
  width = 800,
  height = 600,
  class: extraClass = '',
  loading = 'lazy',
} = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

// Resolve absolute disk path to check existence at build time
const diskPath = join(process.cwd(), 'public', 'images', src);
const fileExists = existsSync(diskPath);

const imgSrc = `${base}/images/${src}`;
---

{fileExists ? (
  <img
    src={imgSrc}
    alt={alt}
    width={width}
    height={height}
    loading={loading}
    decoding="async"
    class={`product-img ${extraClass}`}
  />
) : (
  <div
    class={`product-placeholder ${extraClass}`}
    role="img"
    aria-label={alt}
    style={`aspect-ratio: ${width}/${height};`}
  >
    <svg
      viewBox="0 0 {width} {height}"
      xmlns="http://www.w3.org/2000/svg"
      aria-hidden="true"
      focusable="false"
      style="width:100%;height:100%;display:block;"
    >
      <rect width="100%" height="100%" fill="var(--panel)" />
      <rect
        x="2" y="2"
        width={width - 4}
        height={height - 4}
        fill="none"
        stroke="var(--rule)"
        stroke-width="1"
        stroke-dasharray="6 4"
      />
      <text
        x="50%"
        y="50%"
        text-anchor="middle"
        dominant-baseline="middle"
        font-family="var(--sans)"
        font-size={Math.min(width, height) * 0.055}
        fill="var(--muted)"
      >{alt}</text>
    </svg>
  </div>
)}

<style>
  .product-img {
    display: block;
    width: 100%;
    height: auto;
    object-fit: cover;
  }
  .product-placeholder {
    display: block;
    width: 100%;
    background: var(--panel);
    overflow: hidden;
  }
</style>
