---
import { useTranslations } from '../i18n/index.ts';

interface Props {
  lang?: string;
}

const { lang = 'en' } = Astro.props;
const t = useTranslations(lang);

// BASE_URL always ends with '/'; strip it so we can append paths cleanly.
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const navLinks = [
  { key: 'nav.products',       href: `${base}/products/` },
  { key: 'nav.specifications', href: `${base}/specifications/` },
  { key: 'nav.howWeSource',    href: `${base}/how-we-source/` },
  { key: 'nav.about',          href: `${base}/about/` },
  { key: 'nav.contact',        href: `${base}/contact/` },
] as const;

const langOptions = [
  { value: 'en', disabled: false },
  { value: 'hi', disabled: true },
  { value: 'ar', disabled: true },
  { value: 'fr', disabled: true },
  { value: 'es', disabled: true },
] as const;
---

<header role="banner" class="site-header">
  <div class="header-inner">

    <!-- Wordmark -->
    <a href={`${base}/`} class="wordmark-link" aria-label="Averon Overseas – home">
      <span class="wordmark">AVERON OVERSEAS</span>
      <span class="tagline">Enable Better Reach</span>
    </a>

    <!-- Desktop primary nav -->
    <nav aria-label="Main" class="desktop-nav">
      <ul>
        {navLinks.map(({ key, href }) => (
          <li><a href={href}>{t(key)}</a></li>
        ))}
      </ul>
    </nav>

    <!-- Desktop controls: language selector + CTA -->
    <div class="desktop-controls">
      <select aria-label={t('lang.en')} class="lang-select">
        {langOptions.map(({ value, disabled }) => (
          <option value={value} disabled={disabled || undefined} selected={value === lang || undefined}>
            {t(`lang.${value}`)}
          </option>
        ))}
      </select>

      <a href={`${base}/rfq/`} class="cta-btn">{t('nav.requestQuote')}</a>
    </div>

    <!-- Mobile menu (details/summary — zero JS for open/close) -->
    <details class="mobile-menu">
      <summary aria-label={t('nav.requestQuote') ? 'Menu' : 'Menu'}>
        <!-- Hamburger icon -->
        <svg width="24" height="24" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
          <rect x="3" y="6"  width="18" height="2" fill="currentColor" rx="1"/>
          <rect x="3" y="11" width="18" height="2" fill="currentColor" rx="1"/>
          <rect x="3" y="16" width="18" height="2" fill="currentColor" rx="1"/>
        </svg>
      </summary>
      <div class="mobile-dropdown">
        <nav aria-label="Mobile main">
          <ul>
            {navLinks.map(({ key, href }) => (
              <li><a href={href}>{t(key)}</a></li>
            ))}
          </ul>
        </nav>
      </div>
    </details>

  </div>
</header>

<script>
  document.querySelectorAll('.mobile-menu a').forEach(a => {
    a.addEventListener('click', () => {
      (a as HTMLAnchorElement).closest('details')?.removeAttribute('open');
    });
  });
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 20;
    background: var(--paper);
    border-bottom: 1px solid var(--rule);
  }

  .header-inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 24px;
    height: 64px;
    display: flex;
    align-items: center;
    gap: 32px;
  }

  /* ── Wordmark ─────────────────────────────────────────── */
  .wordmark-link {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    flex-shrink: 0;
    min-height: 44px;
    justify-content: center;
  }

  .wordmark-link:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
    border-radius: 2px;
  }

  .wordmark {
    font-family: var(--serif);
    font-size: 1rem;
    font-weight: 400;
    color: var(--ink);
    letter-spacing: 0.04em;
    line-height: 1.2;
  }

  .tagline {
    font-family: var(--sans);
    font-size: 0.6875rem;
    color: var(--muted);
    letter-spacing: 0.02em;
    line-height: 1.3;
  }

  /* ── Desktop nav ─────────────────────────────────────── */
  .desktop-nav {
    flex: 1;
  }

  .desktop-nav ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    gap: 4px;
  }

  .desktop-nav a {
    font-family: var(--sans);
    font-size: 0.875rem;
    color: var(--ink);
    text-decoration: none;
    padding: 10px 12px;
    border-radius: 2px;
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    white-space: nowrap;
  }

  .desktop-nav a:hover {
    color: var(--accent);
    background: var(--panel);
  }

  .desktop-nav a:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  /* ── Desktop controls ────────────────────────────────── */
  .desktop-controls {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-shrink: 0;
  }

  .lang-select {
    font-family: var(--sans);
    font-size: 0.875rem;
    color: var(--ink);
    background: transparent;
    border: 1px solid var(--rule);
    border-radius: 2px;
    padding: 0 8px;
    height: 44px;
    min-width: 60px;
    cursor: pointer;
    appearance: auto;
  }

  .lang-select:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  .cta-btn {
    font-family: var(--sans);
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--on-night);
    background: var(--ink);
    text-decoration: none;
    padding: 0 20px;
    height: 44px;
    display: inline-flex;
    align-items: center;
    border-radius: 2px;
    white-space: nowrap;
    transition: background 0.15s ease;
  }

  .cta-btn:hover {
    background: var(--accent);
  }

  .cta-btn:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }

  /* ── Mobile menu ─────────────────────────────────────── */
  .mobile-menu {
    display: none;
    margin-left: auto;
  }

  .mobile-menu summary {
    list-style: none;
    cursor: pointer;
    color: var(--ink);
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: 2px;
  }

  .mobile-menu summary::-webkit-details-marker {
    display: none;
  }

  .mobile-menu summary:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  .mobile-menu summary:hover {
    background: var(--panel);
  }

  .mobile-dropdown {
    position: absolute;
    top: 64px;
    left: 0;
    right: 0;
    background: var(--paper);
    border-bottom: 1px solid var(--rule);
    z-index: 19;
  }

  .mobile-dropdown nav ul {
    list-style: none;
    margin: 0;
    padding: 8px 24px;
    display: flex;
    flex-direction: column;
  }

  .mobile-dropdown a {
    font-family: var(--sans);
    font-size: 1rem;
    color: var(--ink);
    text-decoration: none;
    padding: 12px 0;
    display: flex;
    align-items: center;
    min-height: 44px;
    border-bottom: 1px solid var(--rule);
  }

  .mobile-dropdown li:last-child a {
    border-bottom: none;
  }

  .mobile-dropdown a:hover {
    color: var(--accent);
  }

  .mobile-dropdown a:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
    border-radius: 2px;
  }

  /* ── Responsive: ≤860 px ─────────────────────────────── */
  @media (max-width: 860px) {
    .desktop-nav,
    .cta-btn {
      display: none;
    }

    .desktop-controls {
      display: none;
    }

    .mobile-menu {
      display: block;
    }
  }
</style>
