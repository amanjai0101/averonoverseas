---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
interface Props { lang?: string; }
const { lang = 'en' } = Astro.props;

const nav = [
  { label: 'Home',         href: `${base}/` },
  { label: 'About',        href: `${base}/about/` },
  { label: 'Products',     href: `${base}/products/` },
  { label: 'Raw Materials',href: `${base}/raw-materials/` },
  { label: 'Documents',    href: `${base}/documents/` },
  { label: 'Contact',      href: `${base}/contact/` },
];
---

<header class="site-header">
  <div class="wrap header-inner">

    <!-- Logo mark + wordmark -->
    <a href={`${base}/`} class="logo-link" aria-label="Averon Overseas — home">
      <img
        src={`${base}/images/averon-logo.webp`}
        alt=""
        aria-hidden="true"
        width="40"
        height="40"
        class="logo-mark"
        loading="eager"
      />
      <span class="wordmark">
        <span class="wm-name">AVERON OVERSEAS</span>
        <span class="wm-tag">Enable Better Reach</span>
      </span>
    </a>

    <!-- Desktop nav -->
    <nav aria-label="Main" class="desktop-nav">
      <ul>
        {nav.map(n => <li><a href={n.href}>{n.label}</a></li>)}
      </ul>
    </nav>

    <!-- Language + CTA -->
    <div class="header-end">
      <select aria-label="Language" class="lang-select">
        <option value="en" selected>EN</option>
        <option disabled>हिन्दी (soon)</option>
        <option disabled>العربية (soon)</option>
      </select>
      <a href={`${base}/rfq/`} class="btn btn-primary cta-btn">Request a quote</a>
    </div>

    <!-- Mobile hamburger -->
    <details class="mobile-menu">
      <summary aria-label="Open navigation menu">
        <svg width="22" height="22" viewBox="0 0 22 22" aria-hidden="true" focusable="false" fill="none">
          <rect x="2" y="5"  width="18" height="1.5" fill="currentColor"/>
          <rect x="2" y="10" width="18" height="1.5" fill="currentColor"/>
          <rect x="2" y="15" width="18" height="1.5" fill="currentColor"/>
        </svg>
      </summary>
      <div class="mobile-dropdown">
        <nav aria-label="Mobile navigation">
          <ul>
            {nav.map(n => <li><a href={n.href}>{n.label}</a></li>)}
            <li class="mobile-cta-item">
              <a href={`${base}/rfq/`} class="btn btn-primary btn-block">Request a quote</a>
            </li>
          </ul>
        </nav>
      </div>
    </details>

  </div>
</header>

<script>
  document.querySelectorAll('.mobile-menu nav a').forEach(a => {
    a.addEventListener('click', () => {
      (a as HTMLElement).closest('details')?.removeAttribute('open');
    });
  });
</script>

<style>
  .site-header {
    position: sticky; top: 0; z-index: 40;
    background: var(--panel);
    border-bottom: 1px solid var(--hair);
  }
  .header-inner {
    display: flex; align-items: center; gap: 16px; height: 68px;
  }

  /* Logo */
  .logo-link {
    display: flex; align-items: center; gap: 10px;
    text-decoration: none; flex-shrink: 0; margin-right: auto; min-height: 44px;
  }
  .logo-link:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }
  .logo-mark {
    width: 40px; height: 40px; object-fit: contain;
    background: transparent; flex-shrink: 0;
  }
  .wordmark { display: flex; flex-direction: column; justify-content: center; }
  .wm-name {
    font-family: var(--serif); font-size: 0.9375rem; font-weight: 400;
    color: var(--ink); letter-spacing: 0.06em; line-height: 1.15;
  }
  .wm-tag {
    font-family: var(--sans); font-size: 0.625rem; color: var(--muted);
    letter-spacing: 0.12em; line-height: 1.3; text-transform: uppercase;
  }

  /* Desktop nav */
  .desktop-nav ul { list-style: none; margin: 0; padding: 0; display: flex; gap: 0; }
  .desktop-nav a {
    font-size: 0.8125rem; font-weight: 500; color: var(--ink);
    text-decoration: none; padding: 8px 8px;
    display: flex; align-items: center; min-height: 44px;
    white-space: nowrap;
    border-bottom: 2px solid transparent;
    transition: border-color 0.15s, color 0.15s;
  }
  .desktop-nav a:hover { color: var(--accent); border-bottom-color: var(--accent); }
  .desktop-nav a:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }

  /* Header end */
  .header-end { display: flex; align-items: center; gap: 8px; flex-shrink: 0; }
  .lang-select {
    font: inherit; font-size: 0.8125rem; background: transparent; color: var(--ink);
    border: 1px solid var(--hair); padding: 0 8px; cursor: pointer; min-height: 36px;
  }
  .cta-btn { font-size: 0.875rem; padding: 10px 18px; min-height: 44px; }

  /* Mobile */
  .mobile-menu { display: none; }
  .mobile-menu summary {
    list-style: none; cursor: pointer; color: var(--ink);
    display: flex; align-items: center; justify-content: center;
    width: 44px; height: 44px;
  }
  .mobile-menu summary::-webkit-details-marker { display: none; }
  .mobile-menu summary:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }

  .mobile-dropdown {
    position: absolute; left: 0; right: 0; top: 68px;
    background: var(--panel); border-bottom: 1px solid var(--hair); z-index: 39;
  }
  .mobile-dropdown ul { list-style: none; margin: 0; padding: 0 20px 16px; display: flex; flex-direction: column; }
  .mobile-dropdown a {
    display: flex; align-items: center; min-height: 48px;
    font-size: 1rem; color: var(--ink); text-decoration: none;
    border-bottom: 1px solid var(--hair); padding: 0;
  }
  .mobile-dropdown li:last-child a { border-bottom: none; }
  .mobile-dropdown a:hover { color: var(--accent); }
  .mobile-cta-item { padding-top: 12px; }
  .mobile-cta-item a { border-bottom: none !important; justify-content: center; }

  @media (max-width: 860px) {
    .desktop-nav, .header-end { display: none; }
    .mobile-menu { display: block; }
    .logo-link { margin-right: 0; }
  }
  /* At 768px keep nav visible but collapse to hamburger only if needed */
  @media (min-width: 861px) and (max-width: 1023px) {
    .desktop-nav a { font-size: 0.75rem; padding: 8px 5px; }
    .cta-btn { font-size: 0.8125rem; padding: 8px 12px; }
    .lang-select { display: none; }
  }
  @media (max-width: 400px) {
    .wm-tag { display: none; }
  }
</style>
