---
import Base from '../layouts/Base.astro';
import { getMaterials } from '../data/index.ts';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const site = (import.meta.env.SITE ?? '').replace(/\/$/, '');
const canonicalURL = `${site}${base}/raw-materials/`;
const groups = await getMaterials();
---
<Base title="Pharma Raw Materials – Averon Overseas" description="APIs, excipients, vitamins, minerals and chemicals sourced in BP, USP, EP and IP grades. CoA, TDS, SDS on request." canonicalURL={canonicalURL}>
  <div class="wrap page-wrap">
    <nav aria-label="Breadcrumb" class="breadcrumb">
      <ol><li><a href={`${base}/`}>Home</a></li><li aria-current="page">Raw Materials</li></ol>
    </nav>
    <header class="page-header">
      <h1>Pharmaceutical raw materials</h1>
      <p class="page-lead">APIs and excipients sourced from qualified manufacturing partners in BP, USP, EP and IP grades. CoA, TDS and SDS available on request.</p>
      <p class="page-lead muted" style="font-size:0.875rem;margin-top:0.5rem">Specifications are indicative. Final specifications confirmed with the supplier at order stage. Products subject to controlled-substance regulations are not listed and are supplied only to licensed buyers.</p>
    </header>
    {groups.map(g => (
      <section class="rm-section" aria-labelledby={`rm-${g.slug}`}>
        <h2 id={`rm-${g.slug}`}>{g.name}</h2>
        <p class="rm-meta muted">Grades: {g.grades.join(', ')} &nbsp;·&nbsp; Docs: {g.docs.join(', ')}</p>
        <ul class="rm-list">
          {g.items.map(item => <li>{item.name}{item.category ? <span class="muted"> — {item.category}</span> : null}</li>)}
        </ul>
      </section>
    ))}
    <div class="rfq-nudge">
      <p>To request a quote or documentation for any raw material, contact us.</p>
      <a href={`${base}/rfq/`} class="btn btn-primary">Request a quote</a>
    </div>
  </div>
</Base>
<style>
  .page-wrap { padding-top: clamp(40px,6vw,72px); padding-bottom: clamp(64px,8vw,112px); }
  .page-header { margin-bottom: 3rem; }
  h1 { margin-bottom: 0.875rem; }
  .page-lead { color: var(--muted); max-width: 64ch; line-height: 1.65; }
  .rm-section { border-top: 1px solid var(--hair); padding: 2rem 0; }
  .rm-section h2 { font-size: 1.375rem; margin-bottom: 0.5rem; }
  .rm-meta { font-size: 0.875rem; margin-bottom: 1rem; }
  .rm-list { columns: 2; gap: 24px; list-style: none; margin: 0; padding: 0; }
  .rm-list li { font-size: 0.9375rem; padding: 4px 0; border-bottom: 1px solid var(--hair); break-inside: avoid; }
  .rfq-nudge { border-top: 1px solid var(--hair); padding-top: 2rem; margin-top: 1rem; display: flex; align-items: center; justify-content: space-between; gap: 24px; flex-wrap: wrap; }
  .rfq-nudge p { color: var(--muted); font-size: 0.9375rem; margin: 0; max-width: 60ch; }
  @media (max-width: 680px) { .rm-list { columns: 1; } .rfq-nudge { flex-direction: column; align-items: flex-start; } }
</style>
