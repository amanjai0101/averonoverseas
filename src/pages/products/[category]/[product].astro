---
import Base from '../../../layouts/Base.astro';
import ProductImage from '../../../components/ProductImage.astro';
import { getCategories, getProducts } from '../../../data/index.ts';
import { formatSpec } from '../../../utils/formatSpec.ts';
import type { GetStaticPaths } from 'astro';

export const getStaticPaths: GetStaticPaths = async () => {
  const cats = await getCategories();
  const paths = [];
  for (const cat of cats) {
    const products = await getProducts(cat.slug);
    for (const product of products) {
      paths.push({ params: { category: cat.slug, product: product.slug }, props: { cat, product } });
    }
  }
  return paths;
};

const { cat, product } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const site = (import.meta.env.SITE ?? '').replace(/\/$/, '');
const canonicalURL = `${site}${base}/products/${cat.slug}/${product.slug}/`;

const heroImage = product.images[0] ?? '';
const allInCat = await getProducts(cat.slug);
const related = allInCat.filter(p => p.slug !== product.slug).slice(0, 3);

const rawTitle = `${product.name} | ${cat.name} | Averon Overseas`;
const seoTitle = rawTitle.length > 60 ? rawTitle.slice(0, 57) + '…' : rawTitle;
const seoDesc = product.summary.length > 155 ? product.summary.slice(0, 152) + '…' : product.summary;

// Derive readable column header from attrs key
function attrLabel(key: string): string {
  const map: Record<string, string> = {
    neck: 'Neck (mm)', neckMm: 'Neck (mm)',
    capacityML: 'Capacity (mL)', capacity: 'Capacity (mL)',
    thicknessMicron: 'Thickness (µm)', thickness: 'Thickness',
    compound: 'Compound', design: 'Design',
    colour: 'Colour', liner: 'Liner',
    capNeck: 'Cap neck', structure: 'Structure',
    opening: 'Opening', size: 'Size',
    unit: null, // skip
  };
  if (map[key] === null) return '';
  return map[key] ?? (key.charAt(0).toUpperCase() + key.slice(1));
}

// Collect visible attr keys across all variants (exclude 'unit')
const attrKeys = product.variants.length > 0
  ? Object.keys(product.variants[0].attrs).filter(k => attrLabel(k) !== '' && k !== 'unit')
  : [];

const verifiedVariants = product.variants.filter(v => v.status === 'verified' && v.specs?.length);
const hasAnyIndicative = product.variants.some(v => v.status !== 'verified');

const productJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: product.name,
  description: product.summary,
  category: cat.name,
  material: product.materials.join(', '),
  ...(heroImage ? { image: `${site}${base}/images/${heroImage}` } : {}),
  brand: { '@type': 'Organization', name: 'Averon Overseas' },
  offers: { '@type': 'Offer', url: canonicalURL, availability: 'https://schema.org/InStock' },
};

const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home',       item: `${site}${base}/` },
    { '@type': 'ListItem', position: 2, name: 'Products',   item: `${site}${base}/products/` },
    { '@type': 'ListItem', position: 3, name: cat.name,     item: `${site}${base}/products/${cat.slug}/` },
    { '@type': 'ListItem', position: 4, name: product.name, item: canonicalURL },
  ],
};
---

<Base title={seoTitle} description={seoDesc} canonicalURL={canonicalURL}
  ogImage={heroImage ? `${site}${base}/images/${heroImage}` : undefined}>
  <Fragment slot="jsonld">
    <script type="application/ld+json" set:html={JSON.stringify(productJsonLd)} />
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />
  </Fragment>

  <div class="wrap page-wrap">
    <nav aria-label="Breadcrumb" class="breadcrumb">
      <ol>
        <li><a href={`${base}/`}>Home</a></li>
        <li><a href={`${base}/products/`}>Products</a></li>
        <li><a href={`${base}/products/${cat.slug}/`}>{cat.name}</a></li>
        <li aria-current="page">{product.name}</li>
      </ol>
    </nav>

    <!-- Main product grid -->
    <div class="product-grid">
      <div class="product-image-col">
        <ProductImage
          src={heroImage}
          alt={product.name}
          aspectRatio="1/1"
          loading="eager"
        />
      </div>
      <div class="product-info-col">
        <p class="cat-label"><a href={`${base}/products/${cat.slug}/`}>{cat.name}</a></p>
        <h1>{product.name}</h1>
        <p class="product-summary">{product.summary}</p>

        {product.materials.length > 0 && (
          <div class="detail-block">
            <p class="detail-label">Materials</p>
            <ul class="material-list">
              {product.materials.map(m => <li>{m}</li>)}
            </ul>
          </div>
        )}

        {product.sizeRange && product.sizeRange !== 'to-verify' && (
          <div class="detail-block">
            <p class="detail-label">Size range</p>
            <p class="mono">{product.sizeRange}</p>
          </div>
        )}

        {product.colours.length > 0 && (
          <div class="detail-block">
            <p class="detail-label">Colours</p>
            <p>{product.colours.join(', ')}</p>
          </div>
        )}

        {product.docs.length > 0 && (
          <div class="detail-block">
            <p class="detail-label">Documents available on request</p>
            <p class="muted">{product.docs.join(' · ')}</p>
          </div>
        )}

        <a href={`${base}/rfq/?product=${encodeURIComponent(product.slug)}`}
           class="btn btn-primary cta-btn">
          Request a quote
        </a>
      </div>
    </div>

    <!-- Variants table -->
    {product.variants.length > 0 && (
      <section class="spec-section" aria-labelledby="variants-heading">
        <h2 id="variants-heading">Available sizes &amp; variants</h2>
        <div class="table-scroll">
          <table aria-label="Available variants">
            <thead>
              <tr>
                <th>Variant</th>
                {attrKeys.map(k => <th>{attrLabel(k)}</th>)}
              </tr>
            </thead>
            <tbody>
              {product.variants.map(v => (
                <tr>
                  <td class="mono">{v.label}</td>
                  {attrKeys.map(k => <td class="mono">{v.attrs[k] ?? '—'}</td>)}
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        {hasAnyIndicative && (
          <p class="table-note">Dimensions are indicative; confirmed with the supplier at order stage.</p>
        )}
      </section>
    )}

    <!-- Top-level specs -->
    {product.specs.length > 0 && (
      <section class="spec-section" aria-labelledby="specs-heading">
        <h2 id="specs-heading">Specifications</h2>
        <div class="table-scroll">
          <table aria-label={`${product.name} specifications`}>
            <thead><tr><th>Property</th><th>Value</th></tr></thead>
            <tbody>
              {product.specs.map(s => (
                <tr>
                  <th scope="row">{s.key}</th>
                  <td class="mono">{formatSpec({ value: s.value, tol: s.tol, unit: s.unit })}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <p class="table-note">Dimensions typical, confirmed per order.</p>
      </section>
    )}

    <!-- Per-variant spec tables (verified only) -->
    {verifiedVariants.map(v => (
      <section class="spec-section" aria-labelledby={`spec-${v.label.replace(/[\s\/]+/g, '-')}`}>
        <h2 id={`spec-${v.label.replace(/[\s\/]+/g, '-')}`}>
          Specifications — {v.label}
          {v.docRef && <span class="doc-ref">{v.docRef}</span>}
        </h2>
        <div class="table-scroll">
          <table aria-label={`${product.name} ${v.label} specifications`}>
            <thead><tr><th>Property</th><th>Value</th></tr></thead>
            <tbody>
              {v.specs!.map(s => (
                <tr>
                  <th scope="row">{s.key}</th>
                  <td class="mono">{formatSpec({ value: s.value, tol: s.tol, unit: s.unit })}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <p class="table-note">Dimensions typical, confirmed per order.</p>
      </section>
    ))}

    <!-- Related products -->
    {related.length > 0 && (
      <section class="related-section" aria-labelledby="related-heading">
        <h2 id="related-heading">Related products</h2>
        <div class="related-grid" role="list">
          {related.map(p => (
            <a href={`${base}/products/${cat.slug}/${p.slug}/`} class="related-card" role="listitem">
              <div class="related-img">
                <ProductImage src={p.images[0] ?? ''} alt={p.name} aspectRatio="4/3" loading="lazy" />
              </div>
              <div class="related-body">
                <span class="related-name">{p.name}</span>
                {p.sizeRange && p.sizeRange !== 'to-verify' && (
                  <span class="mono muted related-range">{p.sizeRange}</span>
                )}
              </div>
            </a>
          ))}
        </div>
      </section>
    )}

    <!-- Final CTA -->
    <div class="final-cta">
      <div class="callout" style="margin:0;flex:1">
        <p>Standard sizes shown. Need a different size, colour or printing? <a href={`${base}/rfq/?product=${encodeURIComponent(product.slug)}`}>Tell us and we will confirm options →</a></p>
      </div>
      <a href={`${base}/rfq/?product=${encodeURIComponent(product.slug)}`} class="btn btn-primary">
        Request a quote
      </a>
    </div>
  </div>

  <div class="sticky-bar">
    <a href={`${base}/rfq/?product=${encodeURIComponent(product.slug)}`} class="btn btn-primary btn-block">
      Request a quote
    </a>
  </div>
</Base>

<style>
  .page-wrap { padding-top: clamp(40px, 6vw, 72px); padding-bottom: clamp(64px, 8vw, 112px); }

  /* Product grid */
  .product-grid { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(28px, 5vw, 64px); align-items: start; margin-bottom: 3rem; }
  .product-image-col .pi-frame { width: 100%; }
  .cat-label { font-size: 0.875rem; color: var(--muted); margin: 0 0 0.5rem; }
  .cat-label a { color: inherit; text-decoration: none; }
  .cat-label a:hover { text-decoration: underline; }
  h1 { margin-bottom: 0.875rem; }
  .product-summary { color: var(--muted); line-height: 1.65; margin-bottom: 1.5rem; }

  .detail-block { margin-bottom: 1.125rem; }
  .detail-label { font-weight: 600; font-size: 0.8125rem; color: var(--muted); margin: 0 0 0.25rem; }
  .material-list { list-style: none; margin: 0; padding: 0; }
  .material-list li { font-size: 0.9375rem; padding: 2px 0; }
  .cta-btn { margin-top: 1.5rem; }

  /* Spec sections */
  .spec-section { border-top: 1px solid var(--hair); padding: 2rem 0; }
  .spec-section h2 { font-size: 1.25rem; margin-bottom: 1.25rem; }
  .doc-ref { font-family: var(--mono); font-size: 0.75rem; color: var(--muted); margin-left: 8px; }
  .table-scroll { overflow-x: auto; }
  .table-note { font-size: 0.8125rem; color: var(--muted); margin: 0.75rem 0 0; }

  /* Related */
  .related-section { border-top: 1px solid var(--hair); padding: 2rem 0; }
  .related-section h2 { font-size: 1.25rem; margin-bottom: 1.25rem; }
  .related-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; }
  .related-card { text-decoration: none; color: inherit; border: 1px solid var(--hair); transition: border-color 0.15s; }
  .related-card:hover { border-color: var(--ink); }
  .related-card:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  .related-img .pi-frame { width: 100%; }
  .related-body { padding: 10px 12px 12px; display: flex; flex-direction: column; gap: 4px; }
  .related-name { font-family: var(--serif); font-size: 1rem; font-weight: 400; color: var(--ink); }
  .related-range { font-size: 0.8125rem; }

  /* Final CTA */
  .final-cta { border-top: 1px solid var(--hair); padding: 2rem 0; display: flex; align-items: center; gap: 1.5rem; flex-wrap: wrap; }
  .final-cta p { margin: 0; font-size: 1.0625rem; }

  @media (max-width: 860px) {
    .product-grid { grid-template-columns: 1fr; }
    .related-grid { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 540px) {
    .related-grid { grid-template-columns: 1fr; }
  }
</style>
