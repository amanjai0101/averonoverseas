---
import Base from '../../../layouts/Base.astro';
import ProductImage from '../../../components/ProductImage.astro';
import { getCategories, getProducts } from '../../../data/index.ts';
import { formatSpec } from '../../../utils/formatSpec.ts';
import type { GetStaticPaths } from 'astro';

export const getStaticPaths: GetStaticPaths = async () => {
  const categories = await getCategories();
  const paths = [];
  for (const cat of categories) {
    const products = await getProducts(cat.slug);
    for (const product of products) {
      paths.push({
        params: { category: cat.slug, product: product.slug },
        props: { cat, product },
      });
    }
  }
  return paths;
};

const { cat, product } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const site = import.meta.env.SITE ?? 'https://averonoverseas.github.io';
const canonicalURL = `${site}${base}/products/${cat.slug}/${product.slug}/`;

// Related products: same category, excluding this one (max 3)
const allInCat = await getProducts(cat.slug);
const related = allInCat.filter(p => p.slug !== product.slug).slice(0, 3);

// SEO title / description
const seoTitle = `${product.name} – ${cat.name} – Averon Overseas`;
const seoDesc  = product.summary.length > 155
  ? product.summary.slice(0, 152) + '…'
  : product.summary;

const heroImage = product.images[0] ?? '';

// Product JSON-LD (no price, no ratings)
const productJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: product.name,
  description: product.summary,
  category: cat.name,
  material: product.materials.join(', '),
  image: heroImage ? `${site}${base}/images/${heroImage}` : undefined,
  brand: { '@type': 'Organization', name: 'Averon Overseas' },
  offers: {
    '@type': 'Offer',
    url: canonicalURL,
    availability: 'https://schema.org/InStock',
    priceCurrency: 'USD',
    price: undefined,
  },
};
// Remove undefined fields
if (!productJsonLd.image) delete productJsonLd.image;
delete (productJsonLd.offers as any).price;

const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home',     item: `${site}${base}/` },
    { '@type': 'ListItem', position: 2, name: 'Products', item: `${site}${base}/products/` },
    { '@type': 'ListItem', position: 3, name: cat.name,   item: `${site}${base}/products/${cat.slug}/` },
    { '@type': 'ListItem', position: 4, name: product.name, item: canonicalURL },
  ],
};

// Determine verified variants for spec tables
const verifiedVariants = product.variants.filter(v => v.status === 'verified' && v.specs?.length);
const hasTopLevelSpecs = product.specs.length > 0;
---

<Base
  title={seoTitle.length > 60 ? seoTitle.slice(0, 57) + '…' : seoTitle}
  description={seoDesc}
  canonicalURL={canonicalURL}
  ogImage={heroImage ? `${site}${base}/images/${heroImage}` : undefined}
>
  <Fragment slot="jsonld">
    <script type="application/ld+json" set:html={JSON.stringify(productJsonLd)} />
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />
  </Fragment>

  <div class="wrap">
    <!-- Breadcrumb -->
    <nav aria-label="Breadcrumb" class="breadcrumb">
      <ol>
        <li><a href={`${base}/`}>Home</a></li>
        <li><a href={`${base}/products/`}>Products</a></li>
        <li><a href={`${base}/products/${cat.slug}/`}>{cat.name}</a></li>
        <li aria-current="page">{product.name}</li>
      </ol>
    </nav>

    <!-- Main grid: image + info -->
    <div class="product-grid">
      <!-- Image -->
      <div class="product-image-col">
        <ProductImage
          src={heroImage}
          alt={product.name}
          width={800}
          height={800}
          loading="eager"
          class="product-main-img"
        />
      </div>

      <!-- Info -->
      <div class="product-info-col">
        <p class="category-label"><a href={`${base}/products/${cat.slug}/`}>{cat.name}</a></p>
        <h1>{product.name}</h1>
        <p class="summary">{product.summary}</p>

        <!-- Materials -->
        {product.materials.length > 0 && (
          <div class="detail-block">
            <h2 class="detail-heading">Materials</h2>
            <ul class="material-list">
              {product.materials.map(m => <li>{m}</li>)}
            </ul>
          </div>
        )}

        <!-- Size range -->
        {product.sizeRange && product.sizeRange !== 'to-verify' && (
          <div class="detail-block">
            <h2 class="detail-heading">Size range</h2>
            <p class="mono">{product.sizeRange}</p>
          </div>
        )}

        <!-- Colours -->
        {product.colours.length > 0 && (
          <div class="detail-block">
            <h2 class="detail-heading">Colours</h2>
            <p>{product.colours.join(', ')}</p>
          </div>
        )}

        <!-- Documents -->
        {product.docs.length > 0 && (
          <div class="detail-block">
            <h2 class="detail-heading">Documents available on request</h2>
            <p class="muted">{product.docs.join(' · ')}</p>
          </div>
        )}

        <!-- CTA -->
        <a
          href={`${base}/rfq/?product=${encodeURIComponent(product.slug)}`}
          class="btn btn-accent cta-btn"
        >Request a quote</a>
      </div>
    </div>

    <!-- Variants & sizes table -->
    {product.variants.length > 0 && (
      <section class="spec-section" aria-labelledby="variants-heading">
        <h2 id="variants-heading">Available sizes &amp; variants</h2>
        <div class="table-scroll">
          <table class="variants-table" aria-label="Available variants">
            <thead>
              <tr>
                <th>Variant</th>
                {Object.keys(product.variants[0]?.attrs ?? {}).map(k => (
                  <th>{k.charAt(0).toUpperCase() + k.slice(1)}</th>
                ))}
                <th>Status</th>
              </tr>
            </thead>
            <tbody>
              {product.variants.map(v => (
                <tr>
                  <td class="mono">{v.label}</td>
                  {Object.values(v.attrs).map(val => (
                    <td class="mono">{val}</td>
                  ))}
                  <td>
                    {v.status === 'verified'
                      ? <span class="badge badge-verified">Verified</span>
                      : <span class="badge badge-unverified">Indicative</span>
                    }
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <p class="footnote">Specifications are indicative. Final specifications confirmed with the supplier at order stage.</p>
      </section>
    )}

    <!-- Top-level spec table (shared across all variants) -->
    {hasTopLevelSpecs && (
      <section class="spec-section" aria-labelledby="specs-heading">
        <h2 id="specs-heading">Specifications</h2>
        <div class="table-scroll">
          <table class="spec-table" aria-label={`${product.name} specifications`}>
            <thead><tr><th>Property</th><th>Value</th></tr></thead>
            <tbody>
              {product.specs.map(s => (
                <tr>
                  <th scope="row">{s.key}</th>
                  <td class="mono">{formatSpec({ value: s.value, tol: s.tol, unit: s.unit })}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <p class="footnote">Dimensions typical, confirmed per order.</p>
      </section>
    )}

    <!-- Per-variant spec tables (verified variants) -->
    {verifiedVariants.map(v => (
      <section class="spec-section" aria-labelledby={`spec-${v.label.replace(/\s+/g,'-')}`}>
        <h2 id={`spec-${v.label.replace(/\s+/g,'-')}`}>
          Specifications — {v.label}
          {v.docRef && <span class="doc-ref"> ({v.docRef})</span>}
        </h2>
        <div class="table-scroll">
          <table class="spec-table" aria-label={`${product.name} ${v.label} specifications`}>
            <thead><tr><th>Property</th><th>Value</th></tr></thead>
            <tbody>
              {v.specs!.map(s => (
                <tr>
                  <th scope="row">{s.key}</th>
                  <td class="mono">{formatSpec({ value: s.value, tol: s.tol, unit: s.unit })}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <p class="footnote">Dimensions typical, confirmed per order.</p>
      </section>
    ))}

    <!-- Related products -->
    {related.length > 0 && (
      <section class="related-section" aria-labelledby="related-heading">
        <h2 id="related-heading">Related products</h2>
        <div class="related-grid" role="list">
          {related.map(p => (
            <a href={`${base}/products/${cat.slug}/${p.slug}/`} class="related-card" role="listitem">
              <ProductImage src={p.images[0] ?? ''} alt={p.name} width={400} height={300} loading="lazy" />
              <div class="related-body">
                <b>{p.name}</b>
                <span class="mono muted">{p.sizeRange}</span>
              </div>
            </a>
          ))}
        </div>
      </section>
    )}

    <!-- Final CTA -->
    <div class="final-cta">
      <p>Ready to enquire about <strong>{product.name}</strong>?</p>
      <a href={`${base}/rfq/?product=${encodeURIComponent(product.slug)}`} class="btn btn-accent">
        Request a quote
      </a>
    </div>
  </div>

  <!-- Mobile sticky bar -->
  <div class="sticky-mobile">
    <a href={`${base}/rfq/?product=${encodeURIComponent(product.slug)}`} class="btn btn-accent btn-block">
      Request a quote
    </a>
  </div>
</Base>

<style>
  .wrap { max-width:1240px; margin:0 auto; padding:clamp(32px,5vw,64px) clamp(20px,4vw,48px); }

  /* breadcrumb */
  .breadcrumb { font-size:.875rem; color:var(--muted); margin-bottom:1.5rem; }
  .breadcrumb ol { list-style:none; margin:0; padding:0; display:flex; gap:.5rem; flex-wrap:wrap; }
  .breadcrumb li+li::before { content:'/'; margin-right:.5rem; }
  .breadcrumb a { color:inherit; text-decoration:none; }
  .breadcrumb a:hover { text-decoration:underline; }

  /* product grid */
  .product-grid { display:grid; grid-template-columns:1fr 1fr; gap:clamp(24px,5vw,72px); align-items:start; margin-bottom:3rem; }
  .product-main-img { width:100%; aspect-ratio:1/1; object-fit:cover; }

  /* info */
  .category-label { font-size:.875rem; color:var(--muted); margin:0 0 .5rem; }
  .category-label a { color:inherit; text-decoration:none; }
  .category-label a:hover { text-decoration:underline; }
  h1 { font-family:var(--serif); font-weight:400; font-size:clamp(26px,3.5vw,40px); margin:0 0 1rem; }
  .summary { color:var(--muted); line-height:1.6; margin:0 0 1.5rem; }

  .detail-block { margin-bottom:1.25rem; }
  .detail-heading { font-family:var(--sans); font-weight:700; font-size:.8125rem; text-transform:uppercase; letter-spacing:.08em; color:var(--muted); margin:0 0 .375rem; }
  .material-list { list-style:none; margin:0; padding:0; }
  .material-list li { font-size:.9375rem; color:var(--ink); padding:.1875rem 0; }
  .mono { font-family:var(--mono); font-size:.9em; }
  .muted { color:var(--muted); }

  .cta-btn { margin-top:1.5rem; }

  /* spec sections */
  .spec-section { border-top:1px solid var(--rule); padding:2rem 0; }
  .spec-section h2 { font-family:var(--serif); font-weight:400; font-size:1.375rem; margin:0 0 1.25rem; }
  .doc-ref { font-family:var(--mono); font-size:.8em; color:var(--muted); }
  .table-scroll { overflow-x:auto; }
  .spec-table, .variants-table { border-collapse:collapse; width:100%; min-width:360px; }
  .spec-table th, .spec-table td,
  .variants-table th, .variants-table td {
    text-align:left; padding:.6875rem 1rem .6875rem 0; border-bottom:1px solid var(--rule); vertical-align:top;
  }
  .spec-table thead th, .variants-table thead th { font-weight:700; font-size:.8125rem; text-transform:uppercase; letter-spacing:.06em; color:var(--muted); }
  .spec-table th[scope=row] { font-weight:400; color:var(--muted); width:46%; padding-right:1rem; }
  .footnote { font-size:.875rem; color:var(--muted); margin:.75rem 0 0; }

  /* badges */
  .badge { display:inline-block; font-size:.75rem; font-weight:600; padding:.125rem .5rem; border-radius:2px; }
  .badge-verified   { background:#d4edda; color:#155724; }
  .badge-unverified { background:var(--panel); color:var(--muted); }

  /* related */
  .related-section { border-top:1px solid var(--rule); padding:2rem 0; }
  .related-section h2 { font-family:var(--serif); font-weight:400; font-size:1.375rem; margin:0 0 1.25rem; }
  .related-grid { display:grid; grid-template-columns:repeat(3,1fr); gap:1px; background:var(--rule); border:1px solid var(--rule); }
  .related-card { display:flex; flex-direction:column; text-decoration:none; color:inherit; background:var(--paper); }
  .related-card:hover { background:var(--panel); }
  .related-card:focus-visible { outline:3px solid var(--accent); outline-offset:2px; }
  .related-body { padding:.875rem 1rem 1rem; display:flex; flex-direction:column; gap:.25rem; }
  .related-body b { font-family:var(--serif); font-weight:400; font-size:1.0625rem; }

  /* final cta */
  .final-cta { border-top:1px solid var(--rule); padding:2rem 0; display:flex; align-items:center; gap:1.5rem; flex-wrap:wrap; }
  .final-cta p { margin:0; font-size:1.0625rem; }

  /* buttons */
  .btn { display:inline-flex;align-items:center;justify-content:center;font-family:var(--sans);font-weight:700;font-size:1rem;padding:.9375rem 1.375rem;text-decoration:none;border:2px solid transparent;min-height:44px;white-space:nowrap; }
  .btn:hover { transform:translate(-2px,-2px); box-shadow:3px 3px 0 var(--accent); }
  .btn-accent { background:var(--accent);border-color:var(--accent);color:#12263F; }
  .btn-block { display:flex;width:100%; }

  /* sticky mobile */
  .sticky-mobile { display:none; }

  @media (max-width:860px) {
    .product-grid { grid-template-columns:1fr; }
    .related-grid { grid-template-columns:1fr 1fr; }
    .sticky-mobile { display:block;position:fixed;left:0;right:0;bottom:0;padding:.625rem 1rem calc(.625rem + env(safe-area-inset-bottom,0px));background:var(--paper);border-top:1px solid var(--rule);z-index:30; }
    body { padding-bottom:72px; }
  }
  @media (max-width:540px) {
    .related-grid { grid-template-columns:1fr; }
  }
  @media (prefers-reduced-motion:reduce) { .btn:hover { transform:none;box-shadow:none; } }
</style>
