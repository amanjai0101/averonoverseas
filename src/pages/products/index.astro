---
import Base from '../../layouts/Base.astro';
import ProductImage from '../../components/ProductImage.astro';
import { getCategories } from '../../data/index.ts';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const site = import.meta.env.SITE ?? 'https://averonoverseas.github.io';
const canonicalURL = `${site}${base}/products/`;

const categories = await getCategories();

const breadcrumb = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home',     item: `${site}${base}/` },
    { '@type': 'ListItem', position: 2, name: 'Products', item: canonicalURL },
  ],
};
---

<Base
  title="Pharmaceutical Primary Packaging – Averon Overseas"
  description="Browse our 2026 catalogue: injectables, bottles, closures, blister films, dosing devices and raw materials sourced from qualified partners."
  canonicalURL={canonicalURL}
>
  <script slot="jsonld" type="application/ld+json" set:html={JSON.stringify(breadcrumb)} />

  <div class="wrap">
    <nav aria-label="Breadcrumb" class="breadcrumb">
      <ol>
        <li><a href={`${base}/`}>Home</a></li>
        <li aria-current="page">Products</li>
      </ol>
    </nav>

    <h1>Products</h1>
    <p class="lead">Six families of pharmaceutical primary packaging, sourced from qualified manufacturing partners. Exact sizes, grades and neck finishes confirmed per order.</p>

    <div class="cat-grid" role="list">
      {categories.map(cat => (
        <a href={`${base}/products/${cat.slug}/`} class="cat-card" role="listitem">
          <div class="cat-img">
            <ProductImage src={cat.image} alt={cat.name} width={800} height={600} loading="lazy" />
          </div>
          <div class="cat-body">
            <h2>{cat.name}</h2>
            <p>{cat.summary}</p>
          </div>
        </a>
      ))}
    </div>
  </div>

  <div class="sticky-mobile">
    <a href={`${base}/rfq/`} class="btn btn-accent btn-block">Request a quote</a>
  </div>
</Base>

<style>
  .wrap { max-width:1240px; margin:0 auto; padding:clamp(32px,5vw,64px) clamp(20px,4vw,48px); }
  .breadcrumb { font-size:0.875rem; color:var(--muted); margin-bottom:1.5rem; }
  .breadcrumb ol { list-style:none; margin:0; padding:0; display:flex; gap:0.5rem; flex-wrap:wrap; }
  .breadcrumb li + li::before { content:'/'; margin-right:0.5rem; }
  .breadcrumb a { color:inherit; text-decoration:none; }
  .breadcrumb a:hover { text-decoration:underline; }
  h1 { font-family:var(--serif); font-weight:400; font-size:clamp(28px,4vw,48px); margin:0 0 1rem; }
  h2 { font-family:var(--serif); font-weight:400; font-size:1.375rem; margin:0 0 0.5rem; }
  .lead { color:var(--muted); max-width:60ch; margin:0 0 2.5rem; line-height:1.6; }
  .cat-grid {
    display:grid; grid-template-columns:repeat(3,1fr);
    gap:0; border-top:2px solid var(--ink);
  }
  .cat-card {
    display:flex; flex-direction:column; text-decoration:none; color:inherit;
    border-bottom:1px solid var(--rule); border-right:1px solid var(--rule);
  }
  .cat-card:nth-child(3n) { border-right:none; }
  .cat-card:hover { background:var(--panel); }
  .cat-card:focus-visible { outline:3px solid var(--accent); outline-offset:2px; }
  .cat-img { overflow:hidden; }
  .cat-img img, .cat-img .product-placeholder { width:100%; aspect-ratio:4/3; object-fit:cover; }
  .cat-body { padding:1.25rem 1.25rem 1.5rem; flex:1; }
  .cat-body p { color:var(--muted); font-size:0.9375rem; margin:0; line-height:1.5; }
  .btn { display:inline-flex;align-items:center;justify-content:center;font-family:var(--sans);font-weight:700;font-size:1rem;padding:.9375rem 1.375rem;text-decoration:none;border:2px solid transparent;min-height:44px; }
  .btn-accent { background:var(--accent);border-color:var(--accent);color:#12263F; }
  .btn-block { display:flex;width:100%; }
  .sticky-mobile { display:none; }
  @media (max-width:860px) {
    .cat-grid { grid-template-columns:1fr 1fr; }
    .cat-card:nth-child(3n) { border-right:1px solid var(--rule); }
    .cat-card:nth-child(2n) { border-right:none; }
    .sticky-mobile { display:block;position:fixed;left:0;right:0;bottom:0;padding:.625rem 1rem calc(.625rem + env(safe-area-inset-bottom,0px));background:var(--paper);border-top:1px solid var(--rule);z-index:30; }
    body { padding-bottom:72px; }
  }
  @media (max-width:540px) {
    .cat-grid { grid-template-columns:1fr; }
    .cat-card:nth-child(2n) { border-right:none; }
  }
</style>
