---
import Base from '../../layouts/Base.astro';
import ProductImage from '../../components/ProductImage.astro';
import { getCategories, getProducts } from '../../data/index.ts';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const site = (import.meta.env.SITE ?? '').replace(/\/$/, '');
const canonicalURL = `${site}${base}/products/`;

const categories = await getCategories();
const allProducts = await getProducts();

const catRanges = new Map<string, string>();
for (const p of allProducts) {
  if (!catRanges.has(p.category) && p.sizeRange && p.sizeRange !== 'to-verify') {
    catRanges.set(p.category, p.sizeRange);
  }
}

const breadcrumb = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home',     item: `${site}${base}/` },
    { '@type': 'ListItem', position: 2, name: 'Products', item: canonicalURL },
  ],
};
---

<Base
  title="Pharmaceutical Packaging Products – Averon Overseas"
  description="Browse our 2026 catalogue: injectables, bottles, closures, blister films, dosing devices and raw materials sourced from qualified partners."
  canonicalURL={canonicalURL}
>
  <Fragment slot="jsonld">
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumb)} />
  </Fragment>

  <div class="wrap page-wrap">
    <nav aria-label="Breadcrumb" class="breadcrumb">
      <ol>
        <li><a href={`${base}/`}>Home</a></li>
        <li aria-current="page">Products</li>
      </ol>
    </nav>

    <header class="page-header">
      <h1>Products</h1>
      <p class="page-lead">Six families of pharmaceutical primary packaging, sourced from qualified manufacturing partners. Exact sizes and grades confirmed per order.</p>
    </header>

    <div class="cat-list" role="list">
      {categories.map(cat => (
        <a href={`${base}/products/${cat.slug}/`} class="cat-row" role="listitem">
          <div class="cat-row-img">
            <ProductImage
              src={cat.image}
              alt={cat.name}
              aspectRatio="4/3"
              loading="lazy"
            />
          </div>
          <div class="cat-row-body">
            <h2>{cat.name}</h2>
            <p class="cat-row-summary">{cat.summary}</p>
            {catRanges.get(cat.slug) && (
              <p class="cat-row-range mono muted">{catRanges.get(cat.slug)}</p>
            )}
          </div>
          <div class="cat-row-arrow" aria-hidden="true">&rarr;</div>
        </a>
      ))}
    </div>

    <div class="rfq-nudge">
      <p>Specifications are indicative. Final specifications confirmed with the supplier at order stage.</p>
      <a href={`${base}/rfq/`} class="btn btn-primary">Request a quote</a>
    </div>
  </div>

  <div class="sticky-bar">
    <a href={`${base}/rfq/`} class="btn btn-primary btn-block">Request a quote</a>
  </div>
</Base>

<style>
  .page-wrap { padding-top: clamp(40px, 6vw, 72px); padding-bottom: clamp(64px, 8vw, 112px); }
  .page-header { margin-bottom: 2.5rem; }
  h1 { margin-bottom: 0.75rem; }
  .page-lead { color: var(--muted); max-width: 60ch; line-height: 1.65; }

  .cat-list { border-top: 1px solid var(--hair); }
  .cat-row {
    display: grid; grid-template-columns: 200px 1fr 32px;
    gap: 28px; align-items: center;
    padding: 28px 0; border-bottom: 1px solid var(--hair);
    text-decoration: none; color: inherit;
    transition: background 0.1s;
  }
  .cat-row:hover { background: var(--band); }
  .cat-row:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  .cat-row-img { overflow: hidden; }
  .cat-row-body { display: flex; flex-direction: column; gap: 6px; }
  .cat-row-body h2 { font-size: 1.25rem; margin: 0; }
  .cat-row-summary { color: var(--muted); font-size: 0.9375rem; line-height: 1.55; }
  .cat-row-range { font-size: 0.8125rem; }
  .cat-row-arrow { font-size: 1.25rem; color: var(--muted); justify-self: end; }

  .rfq-nudge {
    margin-top: 3rem; padding-top: 2rem;
    border-top: 1px solid var(--hair);
    display: flex; align-items: center; justify-content: space-between;
    gap: 24px; flex-wrap: wrap;
  }
  .rfq-nudge p { color: var(--muted); font-size: 0.9rem; max-width: 60ch; margin: 0; }

  @media (max-width: 680px) {
    .cat-row { grid-template-columns: 100px 1fr; }
    .cat-row-arrow { display: none; }
    .rfq-nudge { flex-direction: column; align-items: flex-start; }
  }
</style>
