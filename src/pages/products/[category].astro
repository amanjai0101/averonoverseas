---
import Base from '../../layouts/Base.astro';
import ProductImage from '../../components/ProductImage.astro';
import { getCategories, getProducts } from '../../data/index.ts';
import type { GetStaticPaths } from 'astro';

export const getStaticPaths: GetStaticPaths = async () => {
  const cats = await getCategories();
  return cats.map(cat => ({ params: { category: cat.slug }, props: { cat } }));
};

const { cat } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const site = (import.meta.env.SITE ?? '').replace(/\/$/, '');
const canonicalURL = `${site}${base}/products/${cat.slug}/`;

const products = await getProducts(cat.slug);

const breadcrumb = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home',     item: `${site}${base}/` },
    { '@type': 'ListItem', position: 2, name: 'Products', item: `${site}${base}/products/` },
    { '@type': 'ListItem', position: 3, name: cat.name,   item: canonicalURL },
  ],
};
---

<Base
  title={cat.seoTitle}
  description={cat.seoDescription}
  canonicalURL={canonicalURL}
  ogImage={`${site}${base}/images/${cat.image}`}
>
  <Fragment slot="jsonld">
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumb)} />
  </Fragment>

  <div class="wrap page-wrap">
    <nav aria-label="Breadcrumb" class="breadcrumb">
      <ol>
        <li><a href={`${base}/`}>Home</a></li>
        <li><a href={`${base}/products/`}>Products</a></li>
        <li aria-current="page">{cat.name}</li>
      </ol>
    </nav>

    <header class="cat-header">
      <div class="cat-hero-img">
        <ProductImage src={cat.image} alt={cat.name} aspectRatio="3/2" loading="eager" />
      </div>
      <div class="cat-intro">
        <h1>{cat.name}</h1>
        <p class="cat-summary">{cat.summary}</p>
        <a href={`${base}/rfq/`} class="btn btn-primary">Request a quote</a>
      </div>
    </header>

    {products.length === 0 ? (
      <p class="empty">No products listed yet for this category. <a href={`${base}/rfq/`}>Send an enquiry.</a></p>
    ) : (
      <div class="product-list" role="list">
        {products.map(p => (
          <a href={`${base}/products/${cat.slug}/${p.slug}/`} class="product-row" role="listitem">
            <div class="product-row-img">
              <ProductImage
                src={p.images[0] ?? ''}
                alt={p.name}
                aspectRatio="4/3"
                loading="lazy"
              />
            </div>
            <div class="product-row-body">
              <h2>{p.name}</h2>
              <p class="product-row-summary">{p.summary}</p>
              {p.sizeRange && p.sizeRange !== 'to-verify' && (
                <p class="product-row-range mono muted">{p.sizeRange}</p>
              )}
            </div>
            <div class="product-row-arrow" aria-hidden="true">&rarr;</div>
          </a>
        ))}
      </div>
    )}

    <div class="rfq-nudge">
      <p>Specifications are indicative. Final specifications confirmed with the supplier at order stage.</p>
      <a href={`${base}/rfq/`} class="btn btn-secondary">Request a quote for {cat.name}</a>
    </div>
  </div>

  <div class="sticky-bar">
    <a href={`${base}/rfq/`} class="btn btn-primary btn-block">Request a quote</a>
  </div>
</Base>

<style>
  .page-wrap { padding-top: clamp(40px, 6vw, 72px); padding-bottom: clamp(64px, 8vw, 112px); }

  .cat-header { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(28px, 5vw, 64px); align-items: center; margin-bottom: 3rem; }
  .cat-hero-img .pi-frame { width: 100%; }
  h1 { margin-bottom: 0.875rem; }
  .cat-summary { color: var(--muted); max-width: 52ch; line-height: 1.65; margin-bottom: 1.5rem; }

  .product-list { border-top: 1px solid var(--hair); }
  .product-row {
    display: grid; grid-template-columns: 160px 1fr 32px;
    gap: 24px; align-items: center;
    padding: 24px 0; border-bottom: 1px solid var(--hair);
    text-decoration: none; color: inherit;
    transition: background 0.1s;
  }
  .product-row:hover { background: var(--band); }
  .product-row:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  .product-row-body { display: flex; flex-direction: column; gap: 6px; }
  .product-row-body h2 { font-size: 1.125rem; font-family: var(--serif); font-weight: 400; margin: 0; }
  .product-row-summary { color: var(--muted); font-size: 0.9375rem; line-height: 1.5; }
  .product-row-range { font-size: 0.8125rem; }
  .product-row-arrow { font-size: 1.25rem; color: var(--muted); justify-self: end; }

  .empty { color: var(--muted); padding: 2rem 0; }
  .empty a { color: var(--ink); }

  .rfq-nudge {
    margin-top: 3rem; padding-top: 2rem; border-top: 1px solid var(--hair);
    display: flex; align-items: center; justify-content: space-between;
    gap: 24px; flex-wrap: wrap;
  }
  .rfq-nudge p { color: var(--muted); font-size: 0.875rem; max-width: 60ch; margin: 0; }

  @media (max-width: 860px) {
    .cat-header { grid-template-columns: 1fr; }
  }
  @media (max-width: 680px) {
    .product-row { grid-template-columns: 90px 1fr; }
    .product-row-arrow { display: none; }
    .rfq-nudge { flex-direction: column; align-items: flex-start; }
  }
</style>
