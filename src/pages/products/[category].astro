---
import Base from '../../layouts/Base.astro';
import ProductImage from '../../components/ProductImage.astro';
import { getCategories, getProducts } from '../../data/index.ts';
import type { GetStaticPaths } from 'astro';

export const getStaticPaths: GetStaticPaths = async () => {
  const categories = await getCategories();
  return categories.map(cat => ({ params: { category: cat.slug }, props: { cat } }));
};

const { cat } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const site = import.meta.env.SITE ?? 'https://averonoverseas.github.io';
const canonicalURL = `${site}${base}/products/${cat.slug}/`;

const products = await getProducts(cat.slug);

const breadcrumb = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home',     item: `${site}${base}/` },
    { '@type': 'ListItem', position: 2, name: 'Products', item: `${site}${base}/products/` },
    { '@type': 'ListItem', position: 3, name: cat.name,   item: canonicalURL },
  ],
};
---

<Base
  title={cat.seoTitle}
  description={cat.seoDescription}
  canonicalURL={canonicalURL}
  ogImage={`${site}${base}/images/${cat.image}`}
>
  <script slot="jsonld" type="application/ld+json" set:html={JSON.stringify(breadcrumb)} />

  <div class="wrap">
    <nav aria-label="Breadcrumb" class="breadcrumb">
      <ol>
        <li><a href={`${base}/`}>Home</a></li>
        <li><a href={`${base}/products/`}>Products</a></li>
        <li aria-current="page">{cat.name}</li>
      </ol>
    </nav>

    <header class="cat-header">
      <div class="cat-hero-img">
        <ProductImage src={cat.image} alt={cat.name} width={1200} height={800} loading="eager" />
      </div>
      <div class="cat-intro">
        <h1>{cat.name}</h1>
        <p class="lead">{cat.summary}</p>
        <a href={`${base}/rfq/`} class="btn btn-accent">Request a quote</a>
      </div>
    </header>

    <section aria-label={`${cat.name} products`}>
      {products.length === 0 ? (
        <p class="empty">No products listed yet. <a href={`${base}/rfq/`}>Send an enquiry</a> for this range.</p>
      ) : (
        <div class="product-index" role="list">
          {products.map(p => (
            <a href={`${base}/products/${cat.slug}/${p.slug}/`} class="product-row" role="listitem">
              <div class="row-thumb">
                <ProductImage src={p.images[0] ?? ''} alt={p.name} width={120} height={84} loading="lazy" />
              </div>
              <div class="row-name"><b>{p.name}</b></div>
              <div class="row-desc">{p.summary}</div>
              <div class="row-sizes mono muted">{p.sizeRange}</div>
            </a>
          ))}
        </div>
      )}
    </section>

    <aside class="rfq-inline" aria-label="Quote prompt">
      <p>Specifications are indicative. Final specs confirmed with the supplier at order stage.</p>
      <a href={`${base}/rfq/`} class="btn btn-outline">Request a quote for {cat.name}</a>
    </aside>
  </div>

  <div class="sticky-mobile">
    <a href={`${base}/rfq/`} class="btn btn-accent btn-block">Request a quote</a>
  </div>
</Base>

<style>
  .wrap { max-width:1240px; margin:0 auto; padding:clamp(32px,5vw,64px) clamp(20px,4vw,48px); }
  .breadcrumb { font-size:.875rem; color:var(--muted); margin-bottom:1.5rem; }
  .breadcrumb ol { list-style:none; margin:0; padding:0; display:flex; gap:.5rem; flex-wrap:wrap; }
  .breadcrumb li+li::before { content:'/'; margin-right:.5rem; }
  .breadcrumb a { color:inherit; text-decoration:none; }
  .breadcrumb a:hover { text-decoration:underline; }
  .cat-header { display:grid; grid-template-columns:5fr 7fr; gap:clamp(24px,4vw,56px); align-items:center; margin-bottom:clamp(32px,5vw,56px); }
  .cat-hero-img img, .cat-hero-img .product-placeholder { width:100%; aspect-ratio:3/2; object-fit:cover; }
  h1 { font-family:var(--serif); font-weight:400; font-size:clamp(28px,4vw,48px); margin:0 0 1rem; }
  .lead { color:var(--muted); max-width:52ch; margin:0 0 1.5rem; line-height:1.6; }
  .product-index { border-top:2px solid var(--ink); margin-bottom:2rem; }
  .product-row {
    display:grid; grid-template-columns:120px 1.1fr 1.6fr 1fr;
    gap:1.5rem; align-items:center; padding:1.25rem 0;
    border-bottom:1px solid var(--rule); text-decoration:none; color:inherit;
  }
  .product-row:hover { background:var(--panel); }
  .product-row:focus-visible { outline:3px solid var(--accent); outline-offset:2px; }
  .row-thumb { height:84px; overflow:hidden; }
  .row-name b { font-family:var(--serif); font-weight:400; font-size:1.5rem; line-height:1.15; }
  .row-desc { color:var(--muted); font-size:.9375rem; }
  .row-sizes.mono { font-family:var(--mono); font-size:.875rem; }
  .muted { color:var(--muted); }
  .empty { color:var(--muted); padding:2rem 0; }
  .rfq-inline { border-top:1px solid var(--rule); padding:1.5rem 0; display:flex; align-items:center; justify-content:space-between; gap:1.5rem; flex-wrap:wrap; }
  .rfq-inline p { margin:0; color:var(--muted); font-size:.9375rem; max-width:60ch; }
  .btn { display:inline-flex;align-items:center;justify-content:center;font-family:var(--sans);font-weight:700;font-size:1rem;padding:.9375rem 1.375rem;text-decoration:none;border:2px solid transparent;min-height:44px;white-space:nowrap; }
  .btn:hover { transform:translate(-2px,-2px); box-shadow:3px 3px 0 var(--accent); }
  .btn-accent { background:var(--accent);border-color:var(--accent);color:#12263F; }
  .btn-outline { background:transparent;border-color:var(--ink);color:var(--ink); }
  .btn-block { display:flex;width:100%; }
  .sticky-mobile { display:none; }
  @media (max-width:860px) {
    .cat-header { grid-template-columns:1fr; }
    .product-row { grid-template-columns:84px 1fr; gap:.375rem 1rem; }
    .row-desc, .row-sizes { grid-column:2; }
    .rfq-inline { flex-direction:column; align-items:flex-start; }
    .sticky-mobile { display:block;position:fixed;left:0;right:0;bottom:0;padding:.625rem 1rem calc(.625rem + env(safe-area-inset-bottom,0px));background:var(--paper);border-top:1px solid var(--rule);z-index:30; }
    body { padding-bottom:72px; }
  }
  @media (prefers-reduced-motion:reduce) { .btn:hover { transform:none;box-shadow:none; } }
</style>
