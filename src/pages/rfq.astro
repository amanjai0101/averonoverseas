---
import Base from '../layouts/Base.astro';
import ProductImage from '../components/ProductImage.astro';
import { getProducts } from '../data/index.ts';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const site = (import.meta.env.SITE ?? '').replace(/\/$/, '');
const canonicalURL = `${site}${base}/rfq/`;
const allProducts = await getProducts();
const productNames = allProducts.map(p => p.name).sort();
const web3key = import.meta.env.PUBLIC_WEB3FORMS_KEY ?? '';
---
<Base title="Request a Quote – Averon Overseas" description="Send a quote enquiry for pharmaceutical packaging or raw materials. Averon Overseas, Jaipur, India." canonicalURL={canonicalURL}>
  <div class="wrap page-wrap">
    <nav aria-label="Breadcrumb" class="breadcrumb">
      <ol><li><a href={`${base}/`}>Home</a></li><li aria-current="page">Request a quote</li></ol>
    </nav>

    <div class="rfq-grid">
      <!-- Left tinted panel -->
      <div class="rfq-left">
        <div class="rfq-guide">
          <h2>What to include</h2>
          <ul>
            <li><strong>Product and size</strong><br />Name, neck finish, capacity or thickness</li>
            <li><strong>Quantity</strong><br />Estimated units per order or per year</li>
            <li><strong>Destination country</strong><br />Helps us identify the right grade and documentation</li>
            <li><strong>Target specifications</strong><br />Any regulatory grade (BP, USP, EP, IP), colour or printing requirements</li>
          </ul>
          <div class="rfq-contact">
            <p>Prefer email?</p>
            <p><a href="mailto:info@averonoverseas.com">info@averonoverseas.com</a></p>
            <p><a href="tel:+918591104074">+91-85911-04074</a></p>
            <p><a href="tel:+917073857555">+91-70738-57555</a></p>
          </div>
        </div>
        <div class="rfq-scene">
          <ProductImage src="scene-sample-inspection.webp" alt="Sample inspection" aspectRatio="4/3" loading="lazy" />
        </div>
      </div>

      <!-- Right form -->
      <div class="rfq-right">
        <h1>Request a quote</h1>
        <p class="rfq-sub">Tell us the product, size and quantity. We will come back with options.</p>

        <form id="rfq-form" method="POST" action="https://api.web3forms.com/submit" aria-label="Request a quote" novalidate>
          <input type="hidden" name="access_key" value={web3key || 'REPLACE_WITH_KEY'} />
          <input type="hidden" name="subject" value="Quote request from averonoverseas.com" />
          <input type="text" name="_honey" style="display:none" tabindex="-1" autocomplete="off" />

          <div class="form-row-2">
            <div class="form-field"><label for="rf-name">Name <span class="req">*</span></label><input id="rf-name" name="name" type="text" autocomplete="name" required /><span class="field-error" id="rf-name-error"></span></div>
            <div class="form-field"><label for="rf-company">Company</label><input id="rf-company" name="company" type="text" autocomplete="organization" /></div>
          </div>
          <div class="form-row-2">
            <div class="form-field"><label for="rf-email">Work email <span class="req">*</span></label><input id="rf-email" name="email" type="email" autocomplete="email" required /><span class="field-error" id="rf-email-error"></span></div>
            <div class="form-field"><label for="rf-country">Destination country</label><input id="rf-country" name="country" type="text" autocomplete="country-name" /></div>
          </div>
          <div class="form-field">
            <label for="rf-product">Product and size <span class="req">*</span></label>
            <input id="rf-product" name="product" type="text" list="product-list" placeholder="e.g. 28 mm CRC cap, white" required />
            <span class="field-error" id="rf-product-error"></span>
            <datalist id="product-list">
              {productNames.map(n => <option value={n} />)}
            </datalist>
          </div>
          <div class="form-row-2">
            <div class="form-field"><label for="rf-qty">Quantity</label><input id="rf-qty" name="quantity" type="text" /></div>
            <div class="form-field"><label for="rf-grade">Grade (if applicable)</label><input id="rf-grade" name="grade" type="text" placeholder="e.g. BP, USP" /></div>
          </div>
          <div class="form-field"><label for="rf-notes">Notes</label><textarea id="rf-notes" name="notes" rows="3" placeholder="Colour, printing, specification requirements…"></textarea><span class="field-error" id="rf-notes-error"></span></div>

          <label class="checkbox-row">
            <input type="checkbox" name="consent" required />
            <span>I agree to Averon Overseas processing my enquiry details. <a href={`${base}/privacy/`}>Privacy Policy</a>.</span>
          </label>
          <span class="field-error" id="rf-consent-error"></span>

          <div id="rfq-msg" class="form-msg" aria-live="polite" aria-atomic="true"></div>
          <button type="submit" class="btn btn-primary btn-block">Send quote request</button>
        </form>
      </div>
    </div>
  </div>
</Base>

<script>
  import { validateRfqForm, sanitizeText, sanitizeEmail } from '../utils/formValidation';

  // Pre-fill product field from ?product= URL param
  const params = new URLSearchParams(window.location.search);
  const product = params.get('product');
  if (product) {
    const el = document.getElementById('rf-product') as HTMLInputElement | null;
    if (el) el.value = product;
  }

  const form = document.getElementById('rfq-form') as HTMLFormElement;
  const msg  = document.getElementById('rfq-msg') as HTMLElement;
  
  if (form && msg) {
    form.addEventListener('submit', async e => {
      e.preventDefault();
      
      // Clear previous errors
      document.querySelectorAll('.field-error').forEach(el => el.textContent = '');
      
      // Gather form data
      const nameInput = document.getElementById('rf-name') as HTMLInputElement;
      const emailInput = document.getElementById('rf-email') as HTMLInputElement;
      const productInput = document.getElementById('rf-product') as HTMLInputElement;
      const notesInput = document.getElementById('rf-notes') as HTMLTextAreaElement;
      const consentCheckbox = document.querySelector('input[name="consent"]') as HTMLInputElement;
      
      const formData = {
        name: nameInput.value,
        email: emailInput.value,
        product: productInput.value,
        consent: consentCheckbox.checked,
        company: (document.getElementById('rf-company') as HTMLInputElement).value,
        country: (document.getElementById('rf-country') as HTMLInputElement).value,
        quantity: (document.getElementById('rf-qty') as HTMLInputElement).value,
        grade: (document.getElementById('rf-grade') as HTMLInputElement).value,
        notes: notesInput.value,
      };
      
      // Validate
      const validation = validateRfqForm(formData);
      
      if (!validation.valid) {
        msg.textContent = 'Please fill all required fields correctly.';
        msg.className = 'form-msg form-msg--err form-msg--visible';
        
        // Show field-level errors
        validation.errors.forEach(err => {
          const errorEl = document.getElementById(`rf-${err.field}-error`);
          if (errorEl) errorEl.textContent = err.message;
        });
        return;
      }
      
      // Sanitize before sending
      const sanitized = new FormData(form);
      sanitized.set('name', sanitizeText(formData.name));
      sanitized.set('email', sanitizeEmail(formData.email));
      sanitized.set('product', sanitizeText(formData.product));
      sanitized.set('company', sanitizeText(formData.company));
      sanitized.set('country', sanitizeText(formData.country));
      sanitized.set('quantity', sanitizeText(formData.quantity));
      sanitized.set('grade', sanitizeText(formData.grade));
      sanitized.set('notes', sanitizeText(formData.notes));
      
      msg.textContent = 'Sending…';
      msg.className = 'form-msg form-msg--visible';
      
      try {
        const res = await fetch('https://api.web3forms.com/submit', { method: 'POST', body: sanitized });
        if (res.ok) {
          msg.textContent = 'Thank you — we will be in touch shortly.';
          msg.className = 'form-msg form-msg--ok form-msg--visible';
          form.reset();
          setTimeout(() => { msg.className = 'form-msg'; }, 5000);
        } else {
          msg.textContent = 'Something went wrong. Please try again or email us directly.';
          msg.className = 'form-msg form-msg--err form-msg--visible';
        }
      } catch {
        msg.textContent = 'Could not send. Please email info@averonoverseas.com.';
        msg.className = 'form-msg form-msg--err form-msg--visible';
      }
    });
  }
</script>

<style>
  .page-wrap { padding-top: clamp(40px,6vw,72px); padding-bottom: clamp(64px,8vw,112px); }
  .rfq-grid { display: grid; grid-template-columns: 5fr 7fr; gap: clamp(32px,5vw,72px); margin-top: 2rem; align-items: start; }

  /* Left panel */
  .rfq-left { display: flex; flex-direction: column; gap: 24px; }
  .rfq-guide { background: var(--band); padding: 28px; }
  .rfq-guide h2 { font-size: 1.125rem; margin-bottom: 1rem; }
  .rfq-guide ul { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 14px; border-top: 1px solid var(--hair); padding-top: 1rem; }
  .rfq-guide li { font-size: 0.9rem; color: var(--muted); line-height: 1.55; padding-bottom: 14px; border-bottom: 1px solid var(--hair); }
  .rfq-guide li strong { display: block; color: var(--ink); font-size: 0.9375rem; margin-bottom: 2px; }
  .rfq-guide li:last-child { border-bottom: none; }
  .rfq-contact { margin-top: 1.25rem; border-top: 1px solid var(--hair); padding-top: 1rem; }
  .rfq-contact p { font-size: 0.875rem; color: var(--muted); margin-bottom: 4px; }
  .rfq-contact a { color: var(--ink); text-decoration: none; font-weight: 500; }
  .rfq-contact a:hover { text-decoration: underline; }

  /* Right form */
  h1 { margin-bottom: 0.5rem; }
  .rfq-sub { color: var(--muted); margin-bottom: 1.5rem; }
  form { display: flex; flex-direction: column; gap: 16px; }
  .form-row-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
  .form-msg { font-size: 0.875rem; min-height: 1.4em; }
  .form-msg--ok  { color: #1a6632; }
  .form-msg--err { color: #8b1a1a; }
  .form-msg--visible {
    padding: 12px 14px;
    border-radius: 4px;
    margin-bottom: 8px;
    animation: slideDown 0.3s ease-out;
  }
  .form-msg--ok.form-msg--visible { background: #e8f5e9; border: 1px solid #a5d6a7; }
  .form-msg--err.form-msg--visible { background: #ffebee; border: 1px solid #ef9a9a; }

  .field-error {
    display: block;
    font-size: 0.8125rem;
    color: #8b1a1a;
    margin-top: 3px;
    animation: slideDown 0.2s ease-out;
  }
  .field-error:empty { display: none; }

  .req { color: #8b1a1a; font-weight: 600; }

  @keyframes slideDown {
    from { opacity: 0; transform: translateY(-4px); }
    to { opacity: 1; transform: translateY(0); }
  }

  @media (max-width: 860px) { .rfq-grid { grid-template-columns: 1fr; } .form-row-2 { grid-template-columns: 1fr; } }
</style>
