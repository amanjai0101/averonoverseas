---
import Base from '../layouts/Base.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const site = (import.meta.env.SITE ?? '').replace(/\/$/, '');
const canonicalURL = `${site}${base}/privacy/`;
---
<Base
  title="Privacy Policy – Averon Overseas"
  description="Privacy policy for averonoverseas.com. How we collect, use and protect your data."
  canonicalURL={canonicalURL}
>
  <div class="wrap page-wrap">
    <nav aria-label="Breadcrumb" class="breadcrumb">
      <ol>
        <li><a href={`${base}/`}>Home</a></li>
        <li aria-current="page">Privacy Policy</li>
      </ol>
    </nav>

    <article class="prose">
      <h1>Privacy Policy</h1>
      <p class="updated">Last updated: 2026</p>

      <h2>Who we are</h2>
      <p>Averon Overseas, Jaipur, Rajasthan 302012, India.
         Contact: <a href="mailto:info@averonoverseas.com">info@averonoverseas.com</a></p>

      <h2>What we collect</h2>
      <p>We collect personal data only when you submit a contact or quote request form on this site. The data collected includes your name, email address, company name, and any product information you choose to provide in the message.</p>

      <h2>How we use it</h2>
      <p>We use your contact details solely to respond to your enquiry. We do not sell, rent or share your data with third parties for marketing purposes.</p>

      <h2>Form processing</h2>
      <p>Form submissions are processed by a third-party form service (Formspree). Their privacy policy is available at <a href="https://formspree.io/legal/privacy-policy" rel="noopener noreferrer">formspree.io/legal/privacy-policy</a>.</p>

      <h2>Analytics</h2>
      <p>This site may use cookieless, privacy-friendly web analytics (such as GoatCounter or Cloudflare Web Analytics) that collect aggregate data only — page views, referring sites, and approximate country of origin. No individual identities are tracked and no cookies are set for analytics purposes.</p>

      <h2>Your rights</h2>
      <p>You have the right to request access to, correction of, or deletion of any personal data we hold about you. To exercise these rights, contact us at <a href="mailto:info@averonoverseas.com">info@averonoverseas.com</a>.</p>

      <h2>Data retention</h2>
      <p>We retain enquiry data for as long as necessary to respond to the enquiry and for reasonable follow-up, and then delete it.</p>

      <h2>Changes</h2>
      <p>We may update this policy from time to time. The date at the top of this page will reflect the most recent update.</p>
    </article>
  </div>
</Base>

<style>
  .page-wrap { padding-top: clamp(40px,6vw,72px); padding-bottom: clamp(64px,8vw,112px); }
  .prose { max-width: 68ch; }
  h1 { margin-bottom: 0.5rem; }
  .updated { font-size: 0.875rem; color: var(--muted); margin-bottom: 2rem; }
  h2 { font-size: 1.25rem; margin: 2rem 0 0.625rem; }
  p { color: var(--muted); line-height: 1.65; margin-bottom: 0.875rem; }
  a { color: var(--ink); }
  a:hover { text-decoration: underline; }
</style>
