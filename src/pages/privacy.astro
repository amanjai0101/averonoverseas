---
import Base from '../layouts/Base.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const site = (import.meta.env.SITE ?? '').replace(/\/$/, '');
const canonicalURL = `${site}${base}/privacy/`;
const buildDate = new Date().toISOString().slice(0, 10);
---
<Base
  title="Privacy Policy – Averon Overseas"
  description="Privacy policy for averonoverseas.com — what data we collect, how we use it, and your rights."
  canonicalURL={canonicalURL}
>
  <div class="wrap page-wrap">
    <nav aria-label="Breadcrumb" class="breadcrumb">
      <ol><li><a href={`${base}/`}>Home</a></li><li aria-current="page">Privacy Policy</li></ol>
    </nav>
    <article class="prose">
      <h1>Privacy Policy</h1>
      <p class="updated">Last updated: {buildDate}</p>

      <h2>Who we are</h2>
      <p>Averon Overseas, Jaipur, Rajasthan 302012, India.<br />
      Contact: <a href="mailto:info@averonoverseas.com">info@averonoverseas.com</a></p>

      <h2>What we collect via forms</h2>
      <p>When you submit a contact or quote request form on this site, we may collect the following information that you voluntarily provide:</p>
      <ul>
        <li>Name</li>
        <li>Company name</li>
        <li>Work email address</li>
        <li>Phone number (if provided)</li>
        <li>Product name and size</li>
        <li>Quantity</li>
        <li>Destination country</li>
        <li>Notes or additional requirements</li>
      </ul>

      <h2>How we use it</h2>
      <p>We use your contact details solely to respond to your enquiry and to coordinate any follow-up. We do not sell, rent or share your personal data with third parties for marketing purposes.</p>

      <h2>Form processing (Web3Forms)</h2>
      <p>Form submissions are transmitted via Web3Forms, a third-party form processing service. Web3Forms forwards your submission to our email address. Their privacy policy is available at <a href="https://web3forms.com/privacy" rel="noopener noreferrer">web3forms.com/privacy</a>.</p>

      <h2>Analytics (GoatCounter)</h2>
      <p>This site uses GoatCounter for web analytics. GoatCounter is cookieless and collects no personally identifiable information. It records aggregate data only: page views, referring site, approximate country of origin (from IP, not stored), and browser/device type. No cookies are set. No consent banner is required.</p>
      <p>GoatCounter privacy policy: <a href="https://www.goatcounter.com/help/privacy" rel="noopener noreferrer">goatcounter.com/help/privacy</a>.</p>

      <h2>Cookies</h2>
      <p>This site does not use cookies for analytics, advertising or tracking. If a cookie-based tool is added in the future, this policy will be updated and a consent mechanism will be added first.</p>

      <h2>Data retention</h2>
      <p>We retain enquiry data for as long as necessary to respond to the enquiry and for reasonable follow-up, after which it is deleted.</p>

      <h2>Your rights</h2>
      <p>You have the right to request access to, correction of, or deletion of any personal data we hold about you. To exercise these rights, contact us at <a href="mailto:info@averonoverseas.com">info@averonoverseas.com</a>.</p>

      <h2>Changes to this policy</h2>
      <p>We may update this policy from time to time. The date at the top of this page reflects the most recent update.</p>
    </article>
  </div>
</Base>
<style>
  .page-wrap { padding-top: clamp(40px,6vw,72px); padding-bottom: clamp(64px,8vw,112px); }
  .prose { max-width: 68ch; }
  h1 { margin-bottom: 0.5rem; }
  .updated { font-size: 0.875rem; color: var(--muted); margin-bottom: 2rem; }
  h2 { font-size: 1.25rem; margin: 2rem 0 0.625rem; }
  p { color: var(--muted); line-height: 1.65; margin-bottom: 0.875rem; }
  ul { color: var(--muted); padding-left: 1.5rem; line-height: 1.65; margin-bottom: 0.875rem; }
  ul li { margin-bottom: 0.25rem; }
  a { color: var(--ink); }
  a:hover { text-decoration: underline; }
</style>
