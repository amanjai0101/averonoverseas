---
import Base from '../layouts/Base.astro';
import ProductImage from '../components/ProductImage.astro';
import { getCategories, getProducts, getMaterials } from '../data/index.ts';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const site = (import.meta.env.SITE ?? '').replace(/\/$/, '');
const canonicalURL = `${site}${base}/`;

const categories = await getCategories();
const allProducts = await getProducts();
const materials = await getMaterials();

// Product-type labels per category (for tile subtitle) — Fix 1
const catTypeLabels: Record<string, string> = {
  'injectables':         'Vials · Ampoules · Seals · Stoppers',
  'bottles-containers':  'Glass · PET · HDPE · LDPE',
  'closures-caps':       'ROPP · CRC · Tamper-Evident · Screw Caps',
  'blister-films-foils': 'PVC · PVC/PVDC · Triplex · Cold-Form · Laminates',
  'dosing-dispensing':   'Syringes · Cups · Droppers · Spoons',
  'raw-materials':       'APIs · Excipients · Vitamins · Chemicals',
};

// Build size chips for ALL products with a real sizeRange — Fix 4
const chips: string[] = [];
for (const p of allProducts) {
  if (p.sizeRange && p.sizeRange !== 'to-verify') {
    // Short product label: strip bracketed text, trim
    const shortName = p.name.replace(/\s*\(.*?\)\s*/g, '').trim();
    chips.push(`${shortName}: ${p.sizeRange}`);
  }
}

const materialGroupNames = materials.map(m => m.name);

// Hero slideshow images (CSS-only crossfade)
const heroSlides = [
  { file: 'home-cover.webp',               caption: 'Pharmaceutical packaging',   link: `${base}/products/` },
  { file: 'injectables-hero.webp',          caption: 'Injectables',                link: `${base}/products/injectables/` },
  { file: 'bottles-containers-hero.webp',   caption: 'Bottles & Containers',       link: `${base}/products/bottles-containers/` },
  { file: 'closures-caps-hero.webp',        caption: 'Closures & Caps',            link: `${base}/products/closures-caps/` },
  { file: 'blister-films-foils-hero.webp',  caption: 'Blister Films & Foils',      link: `${base}/products/blister-films-foils/` },
];

const websiteJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'Averon Overseas',
  url: `${site}${base}/`,
};
---

<Base
  title="Pharma Primary Packaging & Raw Materials Supplier India | Averon"
  description="Averon Overseas sources pharmaceutical primary packaging and raw materials for manufacturers worldwide — glass vials, closures, blister films, APIs and excipients. Jaipur, India."
  canonicalURL={canonicalURL}
  ogImage={`${site}${base}/images/og-default.webp`}
>
  <Fragment slot="jsonld">
    <script type="application/ld+json" set:html={JSON.stringify(websiteJsonLd)} />
  </Fragment>

  <!-- ── 1. Hero ──────────────────────────────────────────── -->
  <section class="hero">
    <div class="wrap hero-grid">
      <div class="hero-text">
        <h1>Pharmaceutical packaging and raw materials, sourced with clarity.</h1>
        <p class="hero-sub">Averon Overseas connects manufacturers and brand owners with qualified packaging and material partners.</p>
        <div class="hero-actions">
          <a href={`${base}/rfq/`} class="btn btn-primary">Request a quote</a>
          <a href={`${base}/downloads/averon-overseas-product-catalogue-2026.pdf`} class="btn-text-dl" download>
            ↓ Download catalogue
          </a>
        </div>
      </div>

      <div class="hero-slides-wrap">
        <div class="hero-slides" role="img" aria-label="Product photography slideshow">
          {heroSlides.map((s, i) => (
            <div class={`slide slide-${i}`}>
              <ProductImage
                src={s.file}
                alt={s.caption}
                aspectRatio="3/2"
                loading={i === 0 ? 'eager' : 'lazy'}
              />
            </div>
          ))}
        </div>
        <div class="hero-caption">
          {heroSlides.map((s, i) => (
            <span class={`cap cap-${i}`}>
              <a href={s.link}>{s.caption} →</a>
            </span>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- ── 2. What we source ────────────────────────────────── -->
  <section class="section-band" aria-labelledby="range-heading">
    <div class="wrap">
      <div class="section-head-split">
        <h2 id="range-heading">What we source</h2>
        <p>Six families of pharmaceutical primary packaging. Sizes and grades confirmed per order.</p>
      </div>
      <div class="cat-grid">
        {categories.map(cat => (
          <a href={cat.slug === 'raw-materials' ? `${base}/raw-materials/` : `${base}/products/${cat.slug}/`}
             class="cat-tile"
             aria-label={`${cat.name} — view range`}>
            <div class="cat-tile-img">
              <ProductImage src={cat.image} alt={cat.name} aspectRatio="4/3" loading="lazy" />
            </div>
            <div class="cat-tile-meta">
              <span class="cat-tile-name">{cat.name}</span>
              <span class="cat-tile-range mono muted">{catTypeLabels[cat.slug] ?? ''}</span>
              <span class="cat-tile-hover" aria-hidden="true">View range →</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ── 3. Size chips ────────────────────────────────────── -->
  <section class="section-white chips-section" aria-labelledby="sizes-heading">
    <div class="wrap">
      <div class="section-head-split">
        <h2 id="sizes-heading">Standard sizes</h2>
        <p>Custom sizes, colours and printing available on request. <a href={`${base}/rfq/`}>Tell us what you need →</a></p>
      </div>
      <div class="chips-list" role="list">
        {chips.map(c => <span class="chip mono" role="listitem">{c}</span>)}
      </div>
    </div>
  </section>

  <!-- ── 4. Process + scene (navy band) ───────────────────── -->
  <section class="section-navy" aria-labelledby="process-heading">
    <div class="wrap process-grid">
      <div class="process-scene">
        <ProductImage
          src="scene-warehouse-qc.webp"
          alt="Quality control inspection of pharmaceutical packaging"
          aspectRatio="4/3"
          loading="lazy"
          class="scene-img"
        />
      </div>
      <div class="process-content">
        <h2 id="process-heading">From enquiry to delivery</h2>
        <p class="process-intro">Four steps, with documents shared at the point you need them.</p>
        <ol class="process-steps">
          <li><span class="ps-n">1</span><span class="ps-label">Enquiry</span><span class="ps-desc">Send product, size and quantity.</span></li>
          <li><span class="ps-n">2</span><span class="ps-label">Specification</span><span class="ps-desc">We match it to a qualified partner and confirm the drawing.</span></li>
          <li><span class="ps-n">3</span><span class="ps-label">Documents</span><span class="ps-desc">CoA, TDS and SDS shared on request.</span></li>
          <li><span class="ps-n">4</span><span class="ps-label">Supply</span><span class="ps-desc">Order coordination through to delivery.</span></li>
        </ol>
        <a href={`${base}/rfq/`} class="btn btn-ghost" style="margin-top:1.5rem">Request a quote</a>
      </div>
    </div>
  </section>

  <!-- ── 5. Raw materials band ────────────────────────────── -->
  <section class="section-band" aria-labelledby="rm-heading">
    <div class="wrap rm-grid">
      <div class="rm-img">
        <ProductImage src="raw-materials-hero.webp" alt="Pharmaceutical raw material powders" aspectRatio="4/3" loading="lazy" />
      </div>
      <div class="rm-content">
        <h2 id="rm-heading">Pharma raw materials</h2>
        <p>APIs, excipients, vitamins, minerals and chemicals in BP, USP, EP and IP grades from qualified manufacturing partners.</p>
        <div class="rm-chips" role="list">
          {materialGroupNames.map(g => <span class="rm-chip" role="listitem">{g}</span>)}
        </div>
        <p class="rm-note muted">CoA, TDS, SDS available on request.</p>
        <a href={`${base}/raw-materials/`} class="btn btn-secondary" style="margin-top:1.5rem">View raw materials</a>
      </div>
    </div>
  </section>

  <!-- ── 6. Quote band ────────────────────────────────────── -->
  <section class="quote-band" aria-labelledby="quote-heading">
    <div class="wrap quote-grid">
      <div class="quote-intro">
        <h2 id="quote-heading">Tell us your product, size and quantity.</h2>
        <p>We will come back with options. Or write to <a href="mailto:info@averonoverseas.com">info@averonoverseas.com</a></p>
      </div>
      <form class="quote-form" id="home-quote-form" method="POST" action="https://api.web3forms.com/submit" aria-label="Quick quote enquiry" novalidate>
        <input type="hidden" name="access_key" value={import.meta.env.PUBLIC_WEB3FORMS_KEY ?? 'REPLACE_WITH_KEY'} />
        <input type="hidden" name="subject" value="Quote enquiry from averonoverseas.com" />
        <input type="text" name="_honey" style="display:none" tabindex="-1" autocomplete="off" />
        <div class="form-row-2">
          <div class="form-field">
            <label for="hq-name">Name</label>
            <input id="hq-name" name="name" type="text" autocomplete="name" required />
          </div>
          <div class="form-field">
            <label for="hq-email">Work email</label>
            <input id="hq-email" name="email" type="email" autocomplete="email" required />
          </div>
          <div class="form-field">
            <label for="hq-product">Product</label>
            <input id="hq-product" name="product" type="text" placeholder="e.g. 28 mm CRC cap, white" />
          </div>
          <div class="form-field">
            <label for="hq-qty">Quantity</label>
            <input id="hq-qty" name="quantity" type="text" />
          </div>
        </div>
        <label class="checkbox-row form-consent">
          <input type="checkbox" name="consent" required />
          <span>I agree to Averon Overseas processing my enquiry details. <a href={`${base}/privacy/`}>Privacy Policy</a>.</span>
        </label>
        <div id="hq-msg" class="form-msg" aria-live="polite"></div>
        <button type="submit" class="btn btn-primary">Send enquiry</button>
      </form>
    </div>
  </section>

  <div class="sticky-bar">
    <a href={`${base}/rfq/`} class="btn btn-primary btn-block">Request a quote</a>
  </div>
</Base>

<script>
  const form = document.getElementById('home-quote-form') as HTMLFormElement;
  const msg  = document.getElementById('hq-msg') as HTMLElement;
  if (form && msg) {
    form.addEventListener('submit', async e => {
      e.preventDefault();
      msg.textContent = 'Sending…'; msg.className = 'form-msg';
      try {
        const res = await fetch('https://api.web3forms.com/submit', {
          method: 'POST',
          body: new FormData(form),
        });
        if (res.ok) {
          msg.textContent = 'Thank you — we will be in touch shortly.';
          msg.className = 'form-msg form-msg--ok';
          form.reset();
        } else {
          msg.textContent = 'Something went wrong. Please email us directly.';
          msg.className = 'form-msg form-msg--err';
        }
      } catch {
        msg.textContent = 'Could not send. Please email info@averonoverseas.com.';
        msg.className = 'form-msg form-msg--err';
      }
    });
  }
</script>

<style>
  /* ── Hero ───────────────────────────────────────────────── */
  .hero { padding: 48px 0 clamp(56px, 7vw, 96px); }
  .hero-grid { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(28px, 5vw, 64px); align-items: center; }
  .hero h1 { font-size: clamp(28px, 4vw, 52px); max-width: 18ch; margin-bottom: 1rem; }
  .hero-sub { color: var(--muted); font-size: 1.0625rem; max-width: 44ch; line-height: 1.7; margin-bottom: 2rem; }
  .hero-actions { display: flex; gap: 16px; align-items: center; flex-wrap: wrap; }
  .btn-text-dl { font-size: 0.9375rem; font-weight: 600; color: var(--ink); text-decoration: none; }
  .btn-text-dl:hover { color: var(--accent); }

  /* Slideshow (CSS-only crossfade) */
  .hero-slides-wrap { position: relative; }
  .hero-slides { position: relative; }
  .slide { position: absolute; top: 0; left: 0; width: 100%; opacity: 0; animation: xfade 25s infinite; }
  .slide-0 { position: relative; opacity: 1; animation-delay: 0s; }
  .slide-1 { animation-delay: 5s; }
  .slide-2 { animation-delay: 10s; }
  .slide-3 { animation-delay: 15s; }
  .slide-4 { animation-delay: 20s; }
  @keyframes xfade {
    0%   { opacity: 0; }
    4%   { opacity: 1; }
    20%  { opacity: 1; }
    24%  { opacity: 0; }
    100% { opacity: 0; }
  }

  .hero-caption { margin-top: 8px; font-size: 0.8125rem; color: var(--muted); min-height: 1.4em; position: relative; }
  .cap { position: absolute; left: 0; opacity: 0; animation: xfade 25s infinite; }
  .cap-0 { position: relative; opacity: 1; animation-delay: 0s; }
  .cap-1 { animation-delay: 5s; }
  .cap-2 { animation-delay: 10s; }
  .cap-3 { animation-delay: 15s; }
  .cap-4 { animation-delay: 20s; }
  .hero-caption a { color: var(--muted); text-decoration: none; }
  .hero-caption a:hover { color: var(--ink); }

  @media (prefers-reduced-motion: reduce) {
    .slide, .cap { animation: none !important; opacity: 0; }
    .slide-0, .cap-0 { opacity: 1 !important; }
  }

  /* ── Sections ───────────────────────────────────────────── */
  .section-band { background: var(--band); padding: clamp(56px, 8vw, 112px) 0; }
  .section-white { padding: clamp(56px, 8vw, 112px) 0; }
  .chips-section { padding: clamp(40px, 5vw, 72px) 0; }

  .section-head-split { display: grid; grid-template-columns: 5fr 7fr; gap: 32px; align-items: end; margin-bottom: 2.5rem; }
  .section-head-split p { color: var(--muted); margin: 0; line-height: 1.6; }
  .section-head-split a { color: var(--ink); font-weight: 500; }

  /* ── Category grid ──────────────────────────────────────── */
  .cat-grid {
    display: grid; grid-template-columns: repeat(3, 1fr);
    gap: 1px; background: var(--hair);
    border: 1px solid var(--hair);
  }
  .cat-tile {
    background: var(--panel);
    text-decoration: none; color: inherit;
    display: flex; flex-direction: column;
    transition: background 0.12s;
    position: relative;
  }
  .cat-tile:hover { background: var(--band); }
  .cat-tile:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  .cat-tile-img { overflow: hidden; }
  .cat-tile-meta { padding: 12px 14px 14px; display: flex; flex-direction: column; gap: 4px; }
  .cat-tile-name { font-family: var(--serif); font-size: 1.0625rem; color: var(--ink); }
  .cat-tile-range { font-size: 0.8125rem; }
  .cat-tile-hover { font-size: 0.8125rem; color: var(--accent); opacity: 0; transition: opacity 0.12s; margin-top: 2px; }
  .cat-tile:hover .cat-tile-hover { opacity: 1; }

  /* ── Size chips ─────────────────────────────────────────── */
  .chips-list { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 1.5rem; }
  .chip {
    background: var(--panel); border: 1px solid var(--hair);
    padding: 6px 14px; font-size: 0.8125rem; color: var(--ink);
  }

  /* ── Navy process band ──────────────────────────────────── */
  .section-navy { background: var(--navy); color: #EEF3F7; padding: clamp(56px, 8vw, 112px) 0; }
  .process-grid { display: grid; grid-template-columns: 5fr 7fr; gap: clamp(32px, 5vw, 72px); align-items: center; }
  .process-scene .pi-frame { background: #1a3050; }
  .section-navy h2 { color: #EEF3F7; margin-bottom: 0.875rem; }
  .process-intro { color: rgba(238,243,247,0.75); margin-bottom: 1.75rem; }
  .process-steps {
    list-style: none; margin: 0; padding: 0;
    display: flex; flex-direction: column; gap: 0;
    border-top: 1px solid rgba(238,243,247,0.2);
  }
  .process-steps li {
    display: grid; grid-template-columns: 24px 1fr;
    gap: 0 16px; align-items: baseline;
    padding: 14px 0; border-bottom: 1px solid rgba(238,243,247,0.15);
  }
  .ps-n { font-family: var(--mono); font-size: 0.75rem; color: var(--accent); }
  .ps-label { font-family: var(--serif); font-size: 1.0625rem; color: #EEF3F7; }
  .ps-desc { grid-column: 2; font-size: 0.875rem; color: rgba(238,243,247,0.65); line-height: 1.5; margin-top: 2px; }

  /* ── Raw materials ──────────────────────────────────────── */
  .rm-grid { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(32px, 5vw, 72px); align-items: center; }
  .rm-content h2 { margin-bottom: 0.875rem; }
  .rm-content > p { color: var(--muted); margin-bottom: 1.25rem; line-height: 1.65; }
  .rm-chips { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 0.75rem; }
  .rm-chip { background: var(--panel); border: 1px solid var(--hair); padding: 6px 14px; font-size: 0.8125rem; font-weight: 500; color: var(--ink); }
  .rm-note { font-size: 0.875rem; }

  /* ── Quote band ─────────────────────────────────────────── */
  .quote-band { background: var(--peach-tint); padding: clamp(56px, 7vw, 96px) 0; }
  .quote-grid { display: grid; grid-template-columns: 5fr 7fr; gap: clamp(32px, 5vw, 72px); align-items: start; }
  .quote-intro h2 { margin-bottom: 0.875rem; }
  .quote-intro p { color: var(--muted); font-size: 0.9375rem; }
  .quote-intro a { color: var(--ink); }
  .quote-form { display: flex; flex-direction: column; gap: 16px; }
  .form-row-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
  .form-msg { font-size: 0.875rem; min-height: 1.4em; }
  .form-msg--ok  { color: #1a6632; }
  .form-msg--err { color: #8b1a1a; }

  /* ── Responsive ─────────────────────────────────────────── */
  @media (max-width: 860px) {
    .hero-grid, .process-grid, .rm-grid, .quote-grid { grid-template-columns: 1fr; }
    .section-head-split { grid-template-columns: 1fr; gap: 12px; }
    .cat-grid { grid-template-columns: 1fr 1fr; }
    .form-row-2 { grid-template-columns: 1fr; }
  }
  @media (max-width: 540px) {
    .cat-grid { grid-template-columns: 1fr; }
  }
</style>
