---
import Base from '../layouts/Base.astro';
import ProductImage from '../components/ProductImage.astro';
import { getCategories, getProducts, getMaterials } from '../data/index.ts';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const site = (import.meta.env.SITE ?? '').replace(/\/$/, '');
const canonicalURL = `${site}${base}/`;

const categories = await getCategories();
const allProducts = await getProducts();

// Compute size range per category (first product's sizeRange or blank)
const catRanges = new Map<string, string>();
for (const p of allProducts) {
  if (!catRanges.has(p.category) && p.sizeRange && p.sizeRange !== 'to-verify') {
    catRanges.set(p.category, p.sizeRange);
  }
}

const materialGroups = await getMaterials();
const groupNames = materialGroups.map(m => m.name);

const websiteJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'Averon Overseas',
  url: `${site}${base}/`,
};
---

<Base
  title="Pharmaceutical Packaging Supplier – Averon Overseas"
  description="Averon Overseas sources pharmaceutical primary packaging and raw materials for manufacturers and brand owners worldwide. Jaipur, India."
  canonicalURL={canonicalURL}
  ogImage={`${site}${base}/images/home-cover.webp`}
>
  <Fragment slot="jsonld">
    <script type="application/ld+json" set:html={JSON.stringify(websiteJsonLd)} />
  </Fragment>

  <!-- ── 1. Hero ──────────────────────────────────────────── -->
  <section class="hero" aria-label="Introduction">
    <div class="wrap hero-grid">
      <div class="hero-text">
        <h1>Pharmaceutical packaging and raw materials, sourced with clarity.</h1>
        <p class="hero-lead">Averon Overseas connects manufacturers and brand owners with qualified packaging and material partners.</p>
        <div class="hero-actions">
          <a href={`${base}/rfq/`} class="btn btn-primary">Request a quote</a>
          <a href={`${base}/products/`} class="btn btn-text">Browse products &rarr;</a>
        </div>
      </div>
      <div class="hero-mosaic" aria-hidden="true">
        <div class="mosaic-a">
          <ProductImage src="injectables-glass-vials-1.webp" alt="Glass vials" aspectRatio="4/3" loading="eager" />
        </div>
        <div class="mosaic-b">
          <ProductImage src="closures-caps-crc-1.webp" alt="CRC closures" aspectRatio="1/1" loading="eager" />
        </div>
        <div class="mosaic-c">
          <ProductImage src="blister-films-foils-hero.webp" alt="Blister films" aspectRatio="3/2" loading="eager" />
        </div>
      </div>
    </div>
  </section>

  <!-- ── 2. What we source ────────────────────────────────── -->
  <section class="section-band" aria-labelledby="range-heading">
    <div class="wrap">
      <h2 id="range-heading">What we source</h2>
      <p class="section-sub">Six product families for pharmaceutical primary packaging and raw materials.</p>
      <div class="cat-tiles">
        {categories.map((cat, i) => (
          <a
            href={`${base}/products/${cat.slug}/`}
            class={`cat-tile ${i === 0 ? 'cat-tile--large' : ''}`}
            aria-label={cat.name}
          >
            <div class="cat-tile-img">
              <ProductImage
                src={cat.image}
                alt={cat.name}
                aspectRatio="4/3"
                loading="lazy"
              />
            </div>
            <div class="cat-tile-meta">
              <span class="cat-tile-name">{cat.name}</span>
              {catRanges.get(cat.slug) && (
                <span class="cat-tile-range mono muted">{catRanges.get(cat.slug)}</span>
              )}
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ── 3. Photo band ────────────────────────────────────── -->
  <section class="photo-band" aria-label="Sourcing approach">
    <ProductImage
      src="home-cover.webp"
      alt="Pharmaceutical packaging products arranged on a surface"
      aspectRatio="21/7"
      loading="lazy"
      class="photo-band-img"
    />
    <div class="photo-band-caption">
      <p>Specification-led sourcing, from enquiry to delivery.</p>
    </div>
  </section>

  <!-- ── 4. Raw materials band ────────────────────────────── -->
  <section class="section-white" aria-labelledby="rm-heading">
    <div class="wrap rm-grid">
      <div class="rm-img">
        <ProductImage
          src="raw-materials-hero.webp"
          alt="Pharmaceutical raw material powders"
          aspectRatio="4/3"
          loading="lazy"
        />
      </div>
      <div class="rm-content">
        <h2 id="rm-heading">Pharma raw materials</h2>
        <p>APIs, excipients, vitamins, minerals and chemicals sourced in BP, USP, EP and IP grades.</p>
        <div class="rm-chips" role="list">
          {groupNames.map(g => <span class="rm-chip" role="listitem">{g}</span>)}
        </div>
        <p class="rm-docs muted">CoA, TDS, SDS available on request.</p>
        <a href={`${base}/raw-materials/`} class="btn btn-secondary" style="margin-top:1.25rem;">View raw materials</a>
      </div>
    </div>
  </section>

  <!-- ── 5. Process steps ─────────────────────────────────── -->
  <section class="section-band" aria-labelledby="process-heading">
    <div class="wrap">
      <h2 id="process-heading">How we source</h2>
      <ol class="process-list">
        <li><span class="process-n">1</span><span class="process-label">Enquiry</span><span class="process-desc">Send product, size and quantity.</span></li>
        <li><span class="process-n">2</span><span class="process-label">Specification</span><span class="process-desc">We match it to a qualified partner and confirm the drawing.</span></li>
        <li><span class="process-n">3</span><span class="process-label">Documents</span><span class="process-desc">CoA, TDS and SDS shared on request.</span></li>
        <li><span class="process-n">4</span><span class="process-label">Supply</span><span class="process-desc">Order coordination through to delivery.</span></li>
      </ol>
    </div>
  </section>

  <!-- ── 6. Quote band ────────────────────────────────────── -->
  <section class="quote-band" aria-labelledby="quote-heading">
    <div class="wrap quote-grid">
      <div class="quote-intro">
        <h2 id="quote-heading">Tell us your product, size and quantity.</h2>
        <p>We will come back with options. Or write to <a href="mailto:info@averonoverseas.com">info@averonoverseas.com</a></p>
      </div>
      <form class="quote-form" action={`${base}/rfq/`} method="GET" aria-label="Quick quote enquiry">
        <!-- honeypot -->
        <input type="text" name="_honey" style="display:none" tabindex="-1" autocomplete="off" />
        <div class="form-row">
          <div class="form-field">
            <label for="qf-name">Name</label>
            <input id="qf-name" name="name" type="text" autocomplete="name" required />
          </div>
          <div class="form-field">
            <label for="qf-email">Work email</label>
            <input id="qf-email" name="email" type="email" autocomplete="email" required />
          </div>
          <div class="form-field">
            <label for="qf-product">Product</label>
            <input id="qf-product" name="product" type="text" placeholder="e.g. 28 mm CRC cap, white" />
          </div>
          <div class="form-field">
            <label for="qf-qty">Quantity</label>
            <input id="qf-qty" name="quantity" type="text" />
          </div>
        </div>
        <button type="submit" class="btn btn-primary">Send enquiry</button>
      </form>
    </div>
  </section>

  <!-- Mobile sticky -->
  <div class="sticky-bar">
    <a href={`${base}/rfq/`} class="btn btn-primary btn-block">Request a quote</a>
  </div>
</Base>

<style>
  /* ── Hero ───────────────────────────────────────────────── */
  .hero { padding: clamp(64px, 9vw, 112px) 0; }
  .hero-grid { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(32px, 5vw, 72px); align-items: center; }
  .hero h1 { font-size: clamp(30px, 4.5vw, 52px); margin-bottom: 1.25rem; max-width: 18ch; }
  .hero-lead { color: var(--muted); font-size: 1.0625rem; max-width: 46ch; line-height: 1.7; margin-bottom: 2rem; }
  .hero-actions { display: flex; gap: 16px; flex-wrap: wrap; align-items: center; }

  .hero-mosaic { display: grid; grid-template-columns: 1fr 1fr; grid-template-rows: auto auto; gap: 8px; }
  .mosaic-a { grid-column: 1; grid-row: 1; }
  .mosaic-b { grid-column: 2; grid-row: 1; }
  .mosaic-c { grid-column: 1 / -1; grid-row: 2; }
  .hero-mosaic .pi-frame { border-radius: 0; }

  /* ── Sections ───────────────────────────────────────────── */
  .section-band { background: var(--band); padding: clamp(64px, 8vw, 112px) 0; }
  .section-white { padding: clamp(64px, 8vw, 112px) 0; }
  .section-sub { color: var(--muted); margin: 0.75rem 0 2.5rem; max-width: 56ch; }

  /* ── Category tiles ─────────────────────────────────────── */
  .cat-tiles {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
    margin-top: 2rem;
  }
  .cat-tile--large { grid-column: span 2; }

  .cat-tile {
    text-decoration: none; color: inherit;
    display: flex; flex-direction: column;
    border: 1px solid var(--hair);
    background: #FAFBFC;
    transition: border-color 0.15s;
  }
  .cat-tile:hover { border-color: var(--ink); }
  .cat-tile:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  .cat-tile-img { overflow: hidden; }
  .cat-tile-img .pi-frame { width: 100%; }
  .cat-tile-meta { padding: 12px 14px 14px; display: flex; flex-direction: column; gap: 4px; }
  .cat-tile-name { font-family: var(--serif); font-size: 1.0625rem; font-weight: 400; color: var(--ink); }
  .cat-tile-range { font-size: 0.8125rem; }

  /* ── Photo band ─────────────────────────────────────────── */
  .photo-band { position: relative; overflow: hidden; }
  .photo-band .pi-frame { aspect-ratio: 21/7 !important; width: 100%; max-height: 380px; }
  .photo-band .pi-img { object-fit: cover !important; }
  .photo-band-caption {
    position: absolute; inset: 0;
    display: flex; align-items: center; justify-content: center;
    background: rgba(18, 38, 63, 0.38);
  }
  .photo-band-caption p {
    font-family: var(--serif); font-size: clamp(18px, 2.5vw, 28px);
    color: #fff; text-align: center; max-width: 48ch; padding: 0 24px; margin: 0;
  }
  /* If no image, make band a solid-colour block */
  .photo-band .pi-placeholder {
    min-height: 220px; background: var(--ink); color: rgba(255,255,255,0.7);
    font-family: var(--serif); font-size: clamp(18px, 2.5vw, 28px);
    display: flex; align-items: center; justify-content: center; text-align: center; padding: 48px 24px;
    aspect-ratio: 21/7;
  }

  /* ── Raw materials ──────────────────────────────────────── */
  .rm-grid { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(32px, 5vw, 72px); align-items: center; }
  .rm-content h2 { margin-bottom: 1rem; }
  .rm-content > p { color: var(--muted); margin-bottom: 1.5rem; }
  .rm-chips { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 0.75rem; }
  .rm-chip {
    background: var(--band); color: var(--ink);
    font-size: 0.8125rem; font-weight: 500;
    padding: 6px 14px; border: 1px solid var(--hair);
  }
  .rm-docs { font-size: 0.875rem; }

  /* ── Process ────────────────────────────────────────────── */
  .section-band h2 { margin-bottom: 2rem; }
  .process-list {
    list-style: none; margin: 0; padding: 0;
    display: grid; grid-template-columns: repeat(4, 1fr);
    border-top: 1px solid var(--hair); gap: 0;
  }
  .process-list li {
    padding: 24px 24px 0 0;
    display: flex; flex-direction: column; gap: 6px;
  }
  .process-n { font-family: var(--mono); font-size: 0.75rem; color: var(--muted); }
  .process-label { font-family: var(--serif); font-size: 1.125rem; color: var(--ink); }
  .process-desc { font-size: 0.9rem; color: var(--muted); line-height: 1.5; }

  /* ── Quote band ─────────────────────────────────────────── */
  .quote-band { background: #FBEFE9; padding: clamp(56px, 7vw, 96px) 0; }
  .quote-grid { display: grid; grid-template-columns: 5fr 7fr; gap: clamp(32px, 5vw, 72px); align-items: start; }
  .quote-intro h2 { margin-bottom: 0.75rem; }
  .quote-intro p { color: var(--muted); font-size: 0.9375rem; }
  .quote-intro a { color: var(--ink); font-weight: 500; }
  .quote-form { display: flex; flex-direction: column; gap: 16px; }
  .form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
  .form-field { display: flex; flex-direction: column; gap: 6px; }
  .form-field label { font-size: 0.8125rem; font-weight: 600; color: var(--ink); }
  .form-field input {
    font: inherit; font-size: 0.9375rem; color: var(--ink);
    background: transparent; border: 0;
    border-bottom: 1.5px solid var(--ink);
    padding: 8px 0; outline: none; width: 100%;
  }
  .form-field input::placeholder { color: var(--muted); }
  .form-field input:focus { border-bottom-color: var(--accent); }

  /* ── Responsive ─────────────────────────────────────────── */
  @media (max-width: 860px) {
    .hero-grid, .rm-grid, .quote-grid { grid-template-columns: 1fr; }
    .cat-tiles { grid-template-columns: 1fr 1fr; }
    .cat-tile--large { grid-column: span 2; }
    .process-list { grid-template-columns: 1fr 1fr; }
    .form-row { grid-template-columns: 1fr; }
  }
  @media (max-width: 540px) {
    .cat-tiles { grid-template-columns: 1fr; }
    .cat-tile--large { grid-column: span 1; }
    .hero-mosaic { grid-template-columns: 1fr; }
    .mosaic-c { grid-column: 1; }
    .process-list { grid-template-columns: 1fr; }
  }
</style>
