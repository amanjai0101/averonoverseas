---
import Base from '../layouts/Base.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const site = (import.meta.env.SITE ?? '').replace(/\/$/, '');
const canonicalURL = `${site}${base}/about/`;
---
<Base title="About Averon Overseas" description="Averon Overseas is a sourcing and supply company for pharmaceutical primary packaging and raw materials, based in Jaipur, India." canonicalURL={canonicalURL}>
  <div class="wrap page-wrap">
    <nav aria-label="Breadcrumb" class="breadcrumb">
      <ol><li><a href={`${base}/`}>Home</a></li><li aria-current="page">About</li></ol>
    </nav>
    <div class="about-grid">
      <div class="about-text">
        <h1>About Averon Overseas</h1>
        <p>Averon Overseas is a sourcing and supply company for pharmaceutical primary packaging and raw materials, based in Jaipur, Rajasthan, India.</p>
        <p>We connect pharma manufacturers and brand owners with qualified manufacturing partners, providing clear specifications and documentation at every stage — from enquiry through to delivery.</p>
        <h2>What we do</h2>
        <p>We source packaging — vials, ampoules, bottles, closures, blister films and dosing devices — and pharmaceutical raw materials including APIs, excipients, vitamins and chemicals, all from verified partners supplying in BP, USP, EP and IP grades.</p>
        <h2>How we work</h2>
        <p>Every enquiry is matched to a qualified supplier. Specifications are confirmed against supplier drawings before order. CoA, TDS and SDS documents are shared on request. We coordinate supply from order to delivery.</p>
        <div class="contact-block">
          <p><a href="mailto:info@averonoverseas.com">info@averonoverseas.com</a></p>
          <p><a href="tel:+918591104074">+91-85911-04074</a> &nbsp;·&nbsp; <a href="tel:+917073857555">+91-70738-57555</a></p>
          <p class="muted">Jaipur, Rajasthan 302012, India</p>
        </div>
      </div>
      <div class="about-cta">
        <a href={`${base}/rfq/`} class="btn btn-primary">Request a quote</a>
        <a href={`${base}/products/`} class="btn btn-secondary" style="margin-top:12px">Browse products</a>
      </div>
    </div>
  </div>
</Base>
<style>
  .page-wrap { padding-top: clamp(40px,6vw,72px); padding-bottom: clamp(64px,8vw,112px); }
  .about-grid { display: grid; grid-template-columns: 2fr 1fr; gap: clamp(32px,5vw,64px); align-items: start; }
  h1 { margin-bottom: 1.25rem; }
  h2 { font-size: 1.375rem; margin: 2rem 0 0.75rem; }
  p { color: var(--muted); line-height: 1.65; margin-bottom: 0.875rem; max-width: 60ch; }
  .contact-block { margin-top: 2rem; border-top: 1px solid var(--hair); padding-top: 1.5rem; }
  .contact-block p { margin-bottom: 0.375rem; }
  .contact-block a { color: var(--ink); text-decoration: none; font-weight: 500; }
  .contact-block a:hover { text-decoration: underline; }
  .about-cta { display: flex; flex-direction: column; align-items: flex-start; position: sticky; top: 100px; }
  @media (max-width: 860px) { .about-grid { grid-template-columns: 1fr; } .about-cta { position: static; flex-direction: row; gap: 12px; } }
</style>
