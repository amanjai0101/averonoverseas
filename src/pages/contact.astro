---
import Base from '../layouts/Base.astro';
import { getSiteConfig } from '../data/index.ts';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const site = (import.meta.env.SITE ?? '').replace(/\/$/, '');
const canonicalURL = `${site}${base}/contact/`;
const cfg = await getSiteConfig();
const addr = cfg.address;
const mapsQuery = encodeURIComponent(`${addr.city}, ${addr.state} ${addr.postcode}, ${addr.country}`);
const mapsLink = cfg.mapLinkUrl || `https://maps.google.com/?q=${mapsQuery}`;
const web3key = import.meta.env.PUBLIC_WEB3FORMS_KEY ?? '';
---
<Base title="Contact – Averon Overseas" description="Contact Averon Overseas for pharmaceutical packaging and raw material enquiries. Jaipur, Rajasthan, India." canonicalURL={canonicalURL}>
  <div class="wrap page-wrap">
    <nav aria-label="Breadcrumb" class="breadcrumb">
      <ol><li><a href={`${base}/`}>Home</a></li><li aria-current="page">Contact</li></ol>
    </nav>

    <div class="contact-grid">
      <div class="contact-info">
        <h1>Contact us</h1>
        <p>For enquiries about pharmaceutical packaging, raw materials, documentation or pricing — reach us by email or phone.</p>
        <div class="ci-block">
          <p class="ci-label">Email</p>
          <p><a href={`mailto:${cfg.email}`}>{cfg.email}</a></p>
        </div>
        <div class="ci-block">
          <p class="ci-label">Phone</p>
          {cfg.phones.map(p => <p><a href={`tel:${p.replace(/[^+\d]/g,'')}`}>{p}</a></p>)}
        </div>
        <div class="ci-block">
          <p class="ci-label">Address</p>
          <address>{addr.city}, {addr.state} {addr.postcode}, {addr.country}</address>
        </div>
        <p class="rfq-note">For a product enquiry with size and quantity, use the <a href={`${base}/rfq/`}>quote request form</a>.</p>
      </div>

      <form class="contact-form" id="contact-form" method="POST" action="https://api.web3forms.com/submit" aria-label="Contact form" novalidate>
        <input type="hidden" name="access_key" value={web3key || 'REPLACE_WITH_KEY'} />
        <input type="hidden" name="subject" value="Contact message from averonoverseas.com" />
        <input type="text" name="_honey" style="display:none" tabindex="-1" autocomplete="off" />
        <div class="form-field"><label for="cf-name">Name <span class="req">*</span></label><input id="cf-name" name="name" type="text" autocomplete="name" required /><span class="field-error" id="cf-name-error"></span></div>
        <div class="form-field"><label for="cf-email">Email <span class="req">*</span></label><input id="cf-email" name="email" type="email" autocomplete="email" required /><span class="field-error" id="cf-email-error"></span></div>
        <div class="form-field"><label for="cf-subject">Subject <span class="req">*</span></label><input id="cf-subject" name="subject_line" type="text" required /><span class="field-error" id="cf-subject-error"></span></div>
        <div class="form-field"><label for="cf-message">Message <span class="req">*</span></label><textarea id="cf-message" name="message" rows="5" required></textarea><span class="field-error" id="cf-message-error"></span></div>
        <label class="checkbox-row">
          <input type="checkbox" name="consent" required />
          <span>I agree to Averon Overseas processing my details to respond to this message. <a href={`${base}/privacy/`}>Privacy Policy</a>.</span>
        </label>
        <span class="field-error" id="cf-consent-error"></span>
        <div id="cf-msg" class="form-msg" aria-live="polite" aria-atomic="true"></div>
        <button type="submit" class="btn btn-primary btn-block">Send message</button>
      </form>
    </div>

    <!-- Map section -->
    <div class="map-section">
      {cfg.mapEmbedUrl ? (
        <iframe
          src={cfg.mapEmbedUrl}
          width="100%"
          height="100%"
          style="border:0;display:block;width:100%;height:100%"
          loading="lazy"
          title="Averon Overseas location map"
          allowfullscreen
          referrerpolicy="no-referrer-when-downgrade"
        />
      ) : (
        <div class="map-placeholder">
          <p class="muted">Jaipur, Rajasthan 302012, India</p>
          <a href={mapsLink} class="btn btn-secondary" target="_blank" rel="noopener noreferrer">
            Open in Google Maps →
          </a>
        </div>
      )}
    </div>
  </div>
</Base>

<script>
  import { validateContactForm, sanitizeText, sanitizeEmail } from '../utils/formValidation';

  const form = document.getElementById('contact-form') as HTMLFormElement;
  const msg  = document.getElementById('cf-msg') as HTMLElement;
  
  if (form && msg) {
    form.addEventListener('submit', async e => {
      e.preventDefault();
      
      // Clear previous errors
      document.querySelectorAll('.field-error').forEach(el => el.textContent = '');
      
      // Gather form data
      const nameInput = document.getElementById('cf-name') as HTMLInputElement;
      const emailInput = document.getElementById('cf-email') as HTMLInputElement;
      const subjectInput = document.getElementById('cf-subject') as HTMLInputElement;
      const messageInput = document.getElementById('cf-message') as HTMLTextAreaElement;
      const consentCheckbox = document.querySelector('input[name="consent"]') as HTMLInputElement;
      
      const formData = {
        name: nameInput.value,
        email: emailInput.value,
        subject: subjectInput.value,
        message: messageInput.value,
        consent: consentCheckbox.checked,
      };
      
      // Validate
      const validation = validateContactForm(formData);
      
      if (!validation.valid) {
        msg.textContent = 'Please fill all required fields correctly.';
        msg.className = 'form-msg form-msg--err form-msg--visible';
        
        // Show field-level errors
        validation.errors.forEach(err => {
          const errorEl = document.getElementById(`cf-${err.field}-error`);
          if (errorEl) errorEl.textContent = err.message;
        });
        return;
      }
      
      // Sanitize before sending
      const sanitized = new FormData(form);
      sanitized.set('name', sanitizeText(formData.name));
      sanitized.set('email', sanitizeEmail(formData.email));
      sanitized.set('subject_line', sanitizeText(formData.subject));
      sanitized.set('message', sanitizeText(formData.message));
      
      msg.textContent = 'Sending…';
      msg.className = 'form-msg form-msg--visible';
      
      try {
        const res = await fetch('https://api.web3forms.com/submit', { method: 'POST', body: sanitized });
        if (res.ok) {
          msg.textContent = 'Message sent. We will be in touch shortly.';
          msg.className = 'form-msg form-msg--ok form-msg--visible';
          form.reset();
          setTimeout(() => { msg.className = 'form-msg'; }, 5000);
        } else {
          msg.textContent = 'Something went wrong. Please try again or email us directly.';
          msg.className = 'form-msg form-msg--err form-msg--visible';
        }
      } catch {
        msg.textContent = 'Could not send. Please email info@averonoverseas.com.';
        msg.className = 'form-msg form-msg--err form-msg--visible';
      }
    });
  }
</script>

<style>
  .page-wrap { padding-top: clamp(40px,6vw,72px); padding-bottom: clamp(64px,8vw,112px); }
  .contact-grid { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(32px,5vw,72px); margin-top: 2rem; align-items: start; }
  h1 { margin-bottom: 1rem; }
  .contact-info > p { color: var(--muted); max-width: 44ch; line-height: 1.65; margin-bottom: 1.75rem; }
  .ci-block { margin-bottom: 1.25rem; }
  .ci-label { font-weight: 600; font-size: 0.8125rem; color: var(--muted); margin: 0 0 0.25rem; }
  .ci-block p, .ci-block address { font-size: 0.9375rem; color: var(--ink); margin: 0 0 0.25rem; font-style: normal; }
  .ci-block a { color: var(--ink); text-decoration: none; font-weight: 500; }
  .ci-block a:hover { text-decoration: underline; }
  .rfq-note { font-size: 0.875rem; color: var(--muted); border-top: 1px solid var(--hair); padding-top: 1rem; margin-top: 1.5rem; }
  .rfq-note a { color: var(--ink); }

  .contact-form { display: flex; flex-direction: column; gap: 18px; }
  .form-msg { font-size: 0.875rem; min-height: 1.4em; }
  .form-msg--ok  { color: #1a6632; }
  .form-msg--err { color: #8b1a1a; }
  .form-msg--visible {
    padding: 12px 14px;
    border-radius: 4px;
    margin-bottom: 8px;
    animation: slideDown 0.3s ease-out;
  }
  .form-msg--ok.form-msg--visible { background: #e8f5e9; border: 1px solid #a5d6a7; }
  .form-msg--err.form-msg--visible { background: #ffebee; border: 1px solid #ef9a9a; }

  .field-error {
    display: block;
    font-size: 0.8125rem;
    color: #8b1a1a;
    margin-top: 3px;
    animation: slideDown 0.2s ease-out;
  }
  .field-error:empty { display: none; }

  .req { color: #8b1a1a; font-weight: 600; }

  @keyframes slideDown {
    from { opacity: 0; transform: translateY(-4px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .map-section { margin-top: 3rem; aspect-ratio: 16/9; background: var(--band); border: 1px solid var(--hair); overflow: hidden; }
  .map-placeholder { width: 100%; height: 100%; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 16px; }

  @media (max-width: 768px) { .contact-grid { grid-template-columns: 1fr; } }
</style>
