---
import Base from '../layouts/Base.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const site = (import.meta.env.SITE ?? '').replace(/\/$/, '');
const canonicalURL = `${site}${base}/contact/`;
---
<Base
  title="Contact – Averon Overseas"
  description="Contact Averon Overseas for pharmaceutical packaging and raw material enquiries. Jaipur, Rajasthan, India."
  canonicalURL={canonicalURL}
>
  <div class="wrap page-wrap">
    <nav aria-label="Breadcrumb" class="breadcrumb">
      <ol>
        <li><a href={`${base}/`}>Home</a></li>
        <li aria-current="page">Contact</li>
      </ol>
    </nav>

    <div class="contact-grid">
      <div class="contact-info">
        <h1>Contact us</h1>
        <p>For enquiries about pharmaceutical packaging, raw materials, documentation or pricing, reach us by email or phone. We respond to all enquiries.</p>

        <div class="contact-block">
          <p class="contact-label">Email</p>
          <p><a href="mailto:info@averonoverseas.com">info@averonoverseas.com</a></p>
        </div>
        <div class="contact-block">
          <p class="contact-label">Phone</p>
          <p><a href="tel:+918591104074">+91-85911-04074</a></p>
          <p><a href="tel:+917073857555">+91-70738-57555</a></p>
        </div>
        <div class="contact-block">
          <p class="contact-label">Address</p>
          <address>
            Averon Overseas<br />
            Jaipur, Rajasthan 302012<br />
            India
          </address>
        </div>

        <p class="contact-rfq-note">
          For a product enquiry with size and quantity, use the
          <a href={`${base}/rfq/`}>quote request form</a>.
        </p>
      </div>

      <form
        class="contact-form"
        action="https://formspree.io/f/REPLACE_ME"
        method="POST"
        aria-label="Contact form"
      >
        <input type="text" name="_honey" style="display:none" tabindex="-1" autocomplete="off" />

        <div class="form-field">
          <label for="cf-name">Name</label>
          <input id="cf-name" name="name" type="text" autocomplete="name" required />
        </div>
        <div class="form-field">
          <label for="cf-email">Email</label>
          <input id="cf-email" name="email" type="email" autocomplete="email" required />
        </div>
        <div class="form-field">
          <label for="cf-subject">Subject</label>
          <input id="cf-subject" name="subject" type="text" />
        </div>
        <div class="form-field">
          <label for="cf-message">Message</label>
          <textarea id="cf-message" name="message" rows="5" required></textarea>
        </div>
        <div class="form-field form-consent">
          <label class="checkbox-label">
            <input type="checkbox" name="consent" required />
            I agree to Averon Overseas processing my details to respond to this message.
            See <a href={`${base}/privacy/`}>Privacy Policy</a>.
          </label>
        </div>
        <button type="submit" class="btn btn-primary btn-block">Send message</button>
      </form>
    </div>
  </div>
</Base>

<style>
  .page-wrap { padding-top: clamp(40px,6vw,72px); padding-bottom: clamp(64px,8vw,112px); }
  .contact-grid { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(32px,5vw,72px); margin-top: 2rem; align-items: start; }
  h1 { margin-bottom: 1rem; }
  .contact-info > p { color: var(--muted); max-width: 44ch; line-height: 1.65; margin-bottom: 2rem; }
  .contact-block { margin-bottom: 1.5rem; }
  .contact-label { font-weight: 600; font-size: 0.8125rem; color: var(--muted); margin: 0 0 0.25rem; }
  .contact-block p, .contact-block address { font-size: 0.9375rem; color: var(--ink); line-height: 1.6; margin: 0 0 0.25rem; font-style: normal; }
  .contact-block a { color: var(--ink); text-decoration: none; font-weight: 500; }
  .contact-block a:hover { text-decoration: underline; }
  .contact-rfq-note { font-size: 0.875rem; color: var(--muted); margin-top: 1.5rem; border-top: 1px solid var(--hair); padding-top: 1rem; }
  .contact-rfq-note a { color: var(--ink); }

  .contact-form { display: flex; flex-direction: column; gap: 18px; }
  .form-field { display: flex; flex-direction: column; gap: 6px; }
  .form-field label { font-size: 0.8125rem; font-weight: 600; color: var(--ink); }
  .form-field input, .form-field textarea {
    font: inherit; font-size: 0.9375rem; color: var(--ink);
    background: transparent; border: 0;
    border-bottom: 1.5px solid var(--hair); padding: 8px 0;
    outline: none; width: 100%; resize: vertical;
  }
  .form-field input:focus, .form-field textarea:focus { border-bottom-color: var(--accent); }
  .form-field input::placeholder, .form-field textarea::placeholder { color: var(--muted); }
  .form-consent { font-size: 0.875rem; color: var(--muted); }
  .checkbox-label { display: flex; gap: 10px; align-items: flex-start; cursor: pointer; }
  .checkbox-label input { margin-top: 3px; flex-shrink: 0; accent-color: var(--accent); }
  .checkbox-label a { color: var(--ink); }

  @media (max-width: 768px) { .contact-grid { grid-template-columns: 1fr; } }
</style>
