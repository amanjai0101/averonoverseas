---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/tokens.css';

interface Props {
  title: string;        // required, ≤60 chars
  description: string;  // required
  canonicalURL: string; // required, full absolute URL
  ogImage?: string;     // optional
  lang?: string;        // default 'en'
  dir?: string;         // default 'ltr'
  alternates?: Array<{ lang: string; url: string }>; // hreflang links
}

/**
 * Resolves the text direction for the HTML element.
 * Forces "rtl" when the BCP 47 base language subtag is ar, he, fa, or ur,
 * regardless of the dir prop value.
 */
export function resolveDir(lang: string, dir: string): string {
  const RTL_LANGS = new Set(['ar', 'he', 'fa', 'ur']);
  const baseSubtag = lang.split('-')[0].toLowerCase();
  return RTL_LANGS.has(baseSubtag) ? 'rtl' : dir;
}

const {
  title,
  description,
  canonicalURL,
  ogImage,
  lang = 'en',
  dir: dirProp = 'ltr',
  alternates,
} = Astro.props;

const resolvedDir = resolveDir(lang, dirProp);

// BASE_URL is injected by Astro from astro.config base; always ends with '/'.
// Strip trailing slash for use in @font-face src paths.
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const orgJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Averon Overseas',
  url: import.meta.env.SITE,
  logo: `${import.meta.env.SITE}${base}/images/averon-logo.webp`,
  email: 'info@averonoverseas.com',
  telephone: ['+91-85911-04074', '+91-70738-57555'],
  address: {
    '@type': 'PostalAddress',
    streetAddress: '',
    addressLocality: 'Jaipur',
    addressRegion: 'Rajasthan',
    postalCode: '302012',
    addressCountry: 'IN',
  },
};
---

<!DOCTYPE html>
<html lang={lang} dir={resolvedDir}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    {alternates?.map(alt => (
      <link rel="alternate" hreflang={alt.lang} href={alt.url} />
    ))}
    <!-- Favicons -->
    <link rel="icon" type="image/x-icon" href={`${base}/favicon.ico`} />
    <link rel="icon" type="image/png" sizes="16x16" href={`${base}/favicon-16x16.png`} />
    <link rel="icon" type="image/png" sizes="32x32" href={`${base}/favicon-32x32.png`} />
    <link rel="apple-touch-icon" sizes="180x180" href={`${base}/apple-touch-icon.png`} />
    <link rel="manifest" href={`${base}/site.webmanifest`} />
    <meta name="theme-color" content="#12263F" />
    <script type="application/ld+json" set:html={JSON.stringify(orgJsonLd)} />
    <slot name="jsonld" />
  </head>
  <body>
    <a href="#main-content" class="skip-link">Skip to main content</a>
    <Header lang={lang} />
    <main id="main-content">
      <slot />
    </main>
    <Footer lang={lang} />
  </body>
</html>

<!-- @font-face rules injected inline so BASE_URL is resolved at build time -->
<style is:inline set:html={`
@font-face{font-family:'Young Serif';font-weight:400;font-style:normal;font-display:swap;src:url('${base}/fonts/young-serif-latin-400-normal.woff2') format('woff2')}
@font-face{font-family:'Hanken Grotesk';font-weight:400;font-style:normal;font-display:swap;src:url('${base}/fonts/hanken-grotesk-latin-400-normal.woff2') format('woff2')}
@font-face{font-family:'Hanken Grotesk';font-weight:500;font-style:normal;font-display:swap;src:url('${base}/fonts/hanken-grotesk-latin-500-normal.woff2') format('woff2')}
@font-face{font-family:'Hanken Grotesk';font-weight:700;font-style:normal;font-display:swap;src:url('${base}/fonts/hanken-grotesk-latin-700-normal.woff2') format('woff2')}
@font-face{font-family:'JetBrains Mono';font-weight:400;font-style:normal;font-display:swap;src:url('${base}/fonts/jetbrains-mono-latin-400-normal.woff2') format('woff2')}
@font-face{font-family:'JetBrains Mono';font-weight:500;font-style:normal;font-display:swap;src:url('${base}/fonts/jetbrains-mono-latin-500-normal.woff2') format('woff2')}
`} />

<style>
  /* ── Global reset ────────────────────────────────────── */
  *, *::before, *::after { box-sizing: border-box; }
  body { margin: 0; background: var(--paper); color: var(--ink); font-family: var(--sans); line-height: 1.6; }
  img, video { max-width: 100%; height: auto; }

  /* ── Skip link ───────────────────────────────────────── */
  .skip-link {
    position: absolute;
    left: -9999px;
    top: auto;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  .skip-link:focus {
    position: fixed;
    left: 1rem;
    top: 1rem;
    width: auto;
    height: auto;
    overflow: visible;
    z-index: 100;
    background: var(--paper);
    color: var(--ink);
    padding: 8px 16px;
    border: 2px solid var(--accent);
    border-radius: 2px;
    font-family: var(--sans);
    text-decoration: none;
  }
</style>
